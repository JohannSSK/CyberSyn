diff --git a/src/static/js/core/loading.js b/src/static/js/core/loading.js
new file mode 100644
index 0000000..f077a48
--- /dev/null
+++ b/src/static/js/core/loading.js
@@ -0,0 +1,205 @@
+/* ==========================================================================
+   loading.js — button spinners, the scanning overlay, toasts.
+
+   Every action in the app gives feedback. `withButton` locks the button and
+   shows a spinner for the duration of a request, so a second click cannot
+   fire the same action twice and the user can see something is happening.
+   ========================================================================== */
+
+(function (global) {
+    "use strict";
+
+    var Icons = global.Icons;
+
+    /* ------------------------------------------------------------------
+       Button loading state
+       ------------------------------------------------------------------ */
+
+    function setLoading(button, isLoading, label) {
+        if (!button) return;
+        if (isLoading) {
+            if (button.dataset.busy === "1") return;
+            button.dataset.busy = "1";
+            button.dataset.label = button.dataset.label || button.textContent;
+            if (!button.querySelector(".btn-spinner")) {
+                var spinner = document.createElement("span");
+                spinner.className = "btn-spinner";
+                button.appendChild(spinner);
+            }
+            button.classList.add("is-loading");
+            button.disabled = true;
+            if (label) button.setAttribute("aria-label", label);
+        } else {
+            button.classList.remove("is-loading");
+            button.disabled = false;
+            delete button.dataset.busy;
+        }
+    }
+
+    /**
+     * Run an async task with the button locked and spinning.
+     *   Loading.withButton(btn, () => Api.post(...)).then(...)
+     */
+    function withButton(button, task, label) {
+        setLoading(button, true, label);
+        return Promise.resolve()
+            .then(task)
+            .finally(function () { setLoading(button, false); });
+    }
+
+    /* ------------------------------------------------------------------
+       Scanning overlay
+       ------------------------------------------------------------------ */
+
+    var STEPS = [
+        { id: "check1", title: "Personal & Greek IDs", sub: "AFM, AMKA, phone numbers and names" },
+        { id: "check2", title: "Confidential context", sub: "Contracts, finances, HR and source code" },
+        { id: "check3", title: "Prompt safety", sub: "Injection and override attempts" },
+        { id: "ai", title: "AI response", sub: "Sending the approved message" }
+    ];
+
+    var overlay = null;
+    var ticker = null;
+
+    function build() {
+        var steps = STEPS.map(function (step) {
+            return '' +
+                '<div class="scan-step" data-step="' + step.id + '">' +
+                '  <span class="mark">' + Icons.svg("check") + '</span>' +
+                '  <span class="scan-step-body">' +
+                '    <strong>' + step.title + '</strong>' +
+                '    <small>' + step.sub + '</small>' +
+                '  </span>' +
+                '  <span class="status">Waiting</span>' +
+                '</div>';
+        }).join("");
+
+        var node = document.createElement("div");
+        node.className = "scan-overlay";
+        node.innerHTML = '' +
+            '<div class="scan-card">' +
+            '  <div class="scan-ring">' +
+            '    <svg class="ring" viewBox="0 0 64 64"><circle class="track" cx="32" cy="32" r="28"/>' +
+            '    <circle class="bar" cx="32" cy="32" r="28"/></svg>' +
+            '    <span class="glyph">' + Icons.svg("shield") + '</span>' +
+            '  </div>' +
+            '  <h3 id="scan-title">Checking your message</h3>' +
+            '  <p class="small muted" id="scan-sub">Running local privacy checks before anything leaves this machine</p>' +
+            '  <div class="scan-steps">' + steps + '</div>' +
+            '  <div class="scan-timer">Elapsed <b id="scan-elapsed">0.0s</b></div>' +
+            '</div>';
+        document.body.appendChild(node);
+        overlay = node;
+        return node;
+    }
+
+    function markStep(id, state) {
+        if (!overlay) return;
+        var row = overlay.querySelector('[data-step="' + id + '"]');
+        if (!row) return;
+        row.classList.remove("active", "done");
+        if (state) {
+            row.classList.add(state);
+            row.querySelector(".status").textContent =
+                state === "done" ? "Done" : "Running";
+        }
+    }
+
+    function resetSteps() {
+        STEPS.forEach(function (step) {
+            var row = overlay && overlay.querySelector('[data-step="' + step.id + '"]');
+            if (row) {
+                row.classList.remove("active", "done");
+                row.querySelector(".status").textContent = "Waiting";
+            }
+        });
+    }
+
+    /**
+     * Show the scanning overlay.
+     * @param {object} flags   which checks are on: {check1, check2, check3}
+     * @param {boolean} bypass true when an administrator approved the send
+     */
+    function showScan(flags, bypass) {
+        var node = overlay || build();
+        resetSteps();
+        node.classList.remove("hidden");
+        node.style.display = "flex";
+
+        var title = bypass ? "Sending with approval" : "Checking your message";
+        node.querySelector("#scan-title").textContent = title;
+
+        var active = STEPS.filter(function (s) {
+            if (s.id === "ai") return true;
+            return flags ? flags[s.id] !== false : true;
+        });
+
+        var index = 0;
+        var startedAt = Date.now();
+
+        function advance() {
+            if (index > 0) markStep(active[index - 1].id, "done");
+            if (index < active.length) {
+                markStep(active[index].id, "active");
+                index += 1;
+                ticker = setTimeout(advance, 380);
+            }
+        }
+        advance();
+
+        var timer = node.querySelector("#scan-elapsed");
+        var clock = setInterval(function () {
+            timer.textContent = ((Date.now() - startedAt) / 1000).toFixed(1) + "s";
+        }, 100);
+
+        return {
+            finish: function (stepId) {
+                if (stepId) markStep(stepId, "done");
+                clearInterval(clock);
+                clearTimeout(ticker);
+            },
+            hide: function () {
+                clearInterval(clock);
+                clearTimeout(ticker);
+                node.style.display = "none";
+            }
+        };
+    }
+
+    function hideScan() {
+        if (!overlay) return;
+        clearInterval(ticker);
+        overlay.style.display = "none";
+    }
+
+    /* ------------------------------------------------------------------
+       Toasts
+       ------------------------------------------------------------------ */
+
+    var ICONS = { success: "check", error: "warning", warn: "warning", info: "spark" };
+
+    function toast(message, type) {
+        var container = document.getElementById("toast-container");
+        if (!container) return;
+        var kind = type || "info";
+        var node = document.createElement("div");
+        node.className = "toast toast-" + kind;
+        node.innerHTML = Icons.svg(ICONS[kind] || "spark", "icon") +
+            '<span>' + global.Dom.esc(message) + '</span>';
+        container.appendChild(node);
+
+        var life = kind === "error" ? 6000 : 3800;
+        setTimeout(function () {
+            node.classList.add("out");
+            setTimeout(function () { node.remove(); }, 260);
+        }, life);
+    }
+
+    global.Loading = {
+        setLoading: setLoading,
+        withButton: withButton,
+        showScan: showScan,
+        hideScan: hideScan,
+        toast: toast
+    };
+})(window);
diff --git a/src/static/js/core/markdown.js b/src/static/js/core/markdown.js
new file mode 100644
index 0000000..6e43092
--- /dev/null
+++ b/src/static/js/core/markdown.js
@@ -0,0 +1,84 @@
+/* ==========================================================================
+   markdown.js — render the small Markdown subset models actually return.
+
+   Fenced code, headings, bullet and numbered lists, rules, bold, italic and
+   inline code. Everything is escaped before it is styled: a model reply is
+   untrusted input and must never be able to inject markup.
+   ========================================================================== */
+
+(function (global) {
+    "use strict";
+
+    var esc = global.Dom.esc;
+    var FENCE = "```";
+
+    function inline(text) {
+        return String(text)
+            .replace(/`([^`]+)`/g, "<code>$1</code>")
+            .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
+            .replace(/(^|[^*])\*([^*\s][^*]*)\*(?!\*)/g, "$1<em>$2</em>");
+    }
+
+    function render(source) {
+        var parts = String(source || "").split(FENCE);
+        var html = "";
+
+        parts.forEach(function (part, index) {
+            // Odd indexes are inside a fence: code, verbatim.
+            if (index % 2 === 1) {
+                var newline = part.indexOf("\n");
+                var code = newline >= 0 ? part.slice(newline + 1) : part;
+                html += "<pre><code>" + esc(code.replace(/\n$/, "")) + "</code></pre>";
+                return;
+            }
+
+            var list = null;
+            var closeList = function () {
+                if (list) { html += "</" + list + ">"; list = null; }
+            };
+
+            part.split("\n").forEach(function (raw) {
+                var m;
+                if (!raw.trim()) { closeList(); return; }
+
+                if ((m = raw.match(/^\s{0,3}(#{1,6})\s+(.*)$/))) {
+                    closeList();
+                    var level = Math.min(m[1].length + 1, 6);
+                    html += "<h" + level + ">" + inline(esc(m[2])) + "</h" + level + ">";
+                    return;
+                }
+                if (/^\s*([-*_])\1{2,}\s*$/.test(raw)) { closeList(); html += "<hr>"; return; }
+                if ((m = raw.match(/^\s*[*+-]\s+(.*)$/))) {
+                    if (list !== "ul") { closeList(); html += "<ul>"; list = "ul"; }
+                    html += "<li>" + inline(esc(m[1])) + "</li>";
+                    return;
+                }
+                if ((m = raw.match(/^\s*(\d+)[.)]\s+(.*)$/))) {
+                    if (list !== "ol") {
+                        closeList();
+                        html += '<ol start="' + parseInt(m[1], 10) + '">';
+                        list = "ol";
+                    }
+                    html += "<li>" + inline(esc(m[2])) + "</li>";
+                    return;
+                }
+                closeList();
+                html += "<p>" + inline(esc(raw)) + "</p>";
+            });
+            closeList();
+        });
+
+        return html;
+    }
+
+    /** Plain-text version, for excerpts and search results. */
+    function strip(source) {
+        return String(source || "")
+            .replace(/```[\s\S]*?```/g, " ")
+            .replace(/[#>*_`]/g, "")
+            .replace(/\s+/g, " ")
+            .trim();
+    }
+
+    global.Markdown = { render: render, strip: strip, inline: inline };
+})(window);
diff --git a/src/static/js/core/shell.js b/src/static/js/core/shell.js
new file mode 100644
index 0000000..8e4b9d6
--- /dev/null
+++ b/src/static/js/core/shell.js
@@ -0,0 +1,102 @@
+/* ==========================================================================
+   shell.js — the shared chrome: sidebar wiring, active page, sign-out.
+
+   Loaded on every page so the navigation behaves the same everywhere and a
+   page script never repeats this.
+   ========================================================================== */
+
+(function (global) {
+    "use strict";
+
+    var Session = global.Api.Session;
+
+    /**
+     * Fill every <span data-icon="name"> with the real icon.
+     * Templates stay readable: <span data-icon="settings"></span>
+     *
+     * Safe to call again after inserting markup: slots already filled are
+     * gone, because they have been replaced by the icon itself.
+     */
+    function paintIcons(root) {
+        global.Dom.$$("span[data-icon]", root).forEach(function (slot) {
+            var name = slot.getAttribute("data-icon");
+            var extra = slot.className;
+            slot.outerHTML = global.Icons.html(name, "icon " + (extra || ""));
+        });
+    }
+
+    /** Mark the sidebar entry for the current path as active. */
+    function markActive() {
+        var here = location.pathname.replace(/\/+$/, "") || "/";
+        global.Dom.$$("[data-nav]").forEach(function (link) {
+            var target = link.getAttribute("data-nav").replace(/\/+$/, "") || "/";
+            var active = target === here ||
+                (target !== "/" && here.indexOf(target) === 0);
+            link.classList.toggle("is-active", active);
+            if (active) link.setAttribute("aria-current", "page");
+        });
+    }
+
+    /** Render the signed-in member into any [data-member-name] element. */
+    function paintMember() {
+        var member = Session.getMember() || {};
+        global.Dom.$$("[data-member-name]").forEach(function (node) {
+            node.textContent = member.username || "Member";
+        });
+        global.Dom.$$("[data-member-avatar]").forEach(function (node) {
+            node.textContent = (member.username || "M").charAt(0).toUpperCase();
+        });
+        global.Dom.$$("[data-workspace]").forEach(function (node) {
+            node.textContent = member.parentId ? ("Workspace " + member.parentId) : "";
+        });
+    }
+
+    function signOut() {
+        var member = Session.getMember() || {};
+        if (member.parentId) {
+            // Best effort: the server drops the session either way.
+            global.Api.post("/api/admin/logout", {}, { member: false }).catch(function () {});
+        }
+        Session.clearAll();
+        location.href = "/";
+    }
+
+    function guard() {
+        if (!Session.ready()) {
+            location.replace("/");
+            return false;
+        }
+        return true;
+    }
+
+    document.addEventListener("DOMContentLoaded", function () {
+        paintIcons(document);
+        markActive();
+        paintMember();
+
+        global.Dom.$$("[data-action='sign-out']").forEach(function (btn) {
+            global.Dom.on(btn, "click", signOut);
+        });
+
+        // Sidebar toggle on narrow screens.
+        var sidebar = global.Dom.$("[data-sidebar]");
+        global.Dom.$$("[data-action='toggle-sidebar']").forEach(function (btn) {
+            global.Dom.on(btn, "click", function () {
+                if (sidebar) sidebar.classList.toggle("is-open");
+            });
+        });
+    });
+
+    /* Called by api.js when the server says the session is gone. */
+    global.onSessionExpired = function () {
+        global.Loading.toast("Your session has ended. Sign in again.", "warn");
+        setTimeout(function () { location.replace("/"); }, 900);
+    };
+
+    global.Shell = {
+        signOut: signOut,
+        guard: guard,
+        paintMember: paintMember,
+        paintIcons: paintIcons
+    };
+})(window);
