+/* ==========================================================================
+   workspace.css — the chat screen: sidebar, message stream, composer.
+   ========================================================================== */
+
+.workspace {
+    display: grid;
+    grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
+    height: 100vh;
+    overflow: hidden;
+}
+
+/* --------------------------------------------------------------------------
+   Sidebar
+   -------------------------------------------------------------------------- */
+
+.sidebar {
+    display: flex;
+    flex-direction: column;
+    min-height: 0;
+    background: linear-gradient(180deg, rgba(11, 18, 36, 0.9), rgba(9, 14, 28, 0.96));
+    border-right: 1px solid var(--border-soft);
+}
+
+.sidebar-brand {
+    display: flex;
+    align-items: center;
+    gap: 11px;
+    height: var(--topbar-h);
+    padding: 0 18px;
+    border-bottom: 1px solid var(--border-soft);
+    flex: none;
+}
+
+.sidebar-brand .icon { width: 24px; height: 24px; }
+
+.sidebar-brand span {
+    font-size: 16px;
+    font-weight: 700;
+    letter-spacing: -0.01em;
+}
+
+.sidebar-nav { padding: 14px 12px 6px; flex: none; }
+
+.nav-item {
+    display: flex;
+    align-items: center;
+    gap: 11px;
+    width: 100%;
+    padding: 9px 11px;
+    margin-bottom: 3px;
+    border-radius: var(--r-md);
+    font-size: 13.5px;
+    font-weight: 500;
+    color: var(--text-dim);
+    background: transparent;
+    border: 1px solid transparent;
+    transition: all var(--fast) var(--ease);
+    text-align: left;
+}
+
+.nav-item:hover { color: var(--text); background: var(--surface-2); }
+
+.nav-item.is-active {
+    color: var(--text);
+    background: var(--accent-soft);
+    border-color: var(--accent-line);
+}
+
+/* Sidebar icons are PNGs, so they carry the accent colour of their own and
+   ignore `color`. Dimming is what distinguishes resting from active. */
+.nav-item .icon { width: 17px; height: 17px; flex: none; opacity: 0.55; transition: opacity var(--ease); }
+.nav-item:hover .icon { opacity: 0.8; }
+.nav-item.is-active .icon { color: var(--accent); opacity: 1; }
+.nav-item .count { margin-left: auto; font-size: 11px; color: var(--text-muted); }
+
+.sidebar-section-head {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    padding: 16px 12px 8px;
+    flex: none;
+}
+
+.sidebar-section-head .eyebrow { font-size: 10.5px; }
+
+.chat-list {
+    flex: 1;
+    min-height: 0;
+    overflow-y: auto;
+    padding: 0 12px 12px;
+}
+
+.chat-item {
+    display: flex;
+    align-items: center;
+    gap: 9px;
+    width: 100%;
+    padding: 9px 11px;
+    margin-bottom: 3px;
+    border-radius: var(--r-md);
+    border: 1px solid transparent;
+    background: transparent;
+    color: var(--text-dim);
+    font-size: 13px;
+    text-align: left;
+    transition: all var(--fast) var(--ease);
+}
+
+.chat-item:hover { background: var(--surface-2); color: var(--text); }
+
+.chat-item.is-active {
+    background: var(--accent-soft);
+    border-color: var(--accent-line);
+    color: var(--text);
+}
+
+.chat-item .icon { width: 15px; height: 15px; flex: none; opacity: 0.65; }
+
+.chat-item-title {
+    flex: 1;
+    min-width: 0;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.chat-item .chat-item-meta { font-size: 10.5px; color: var(--text-muted); flex: none; }
+
+.sidebar-foot {
+    padding: 12px;
+    border-top: 1px solid var(--border-soft);
+    flex: none;
+}
+
+.sidebar-user {
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    padding: 9px 10px;
+    margin-bottom: 8px;
+    border-radius: var(--r-md);
+    background: var(--surface);
+    border: 1px solid var(--border-soft);
+}
+
+.avatar {
+    display: grid;
+    place-items: center;
+    width: 32px;
+    height: 32px;
+    flex: none;
+    border-radius: 50%;
+    background: linear-gradient(140deg, var(--accent), var(--violet));
+    color: #06121F;
+    font-size: 13px;
+    font-weight: 700;
+}
+
+.sidebar-user .who { min-width: 0; }
+.sidebar-user .who strong { display: block; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.sidebar-user .who small { font-size: 11px; color: var(--text-muted); }
+
+/* --------------------------------------------------------------------------
+   Main column
+   -------------------------------------------------------------------------- */
+
+.workspace-main {
+    display: flex;
+    flex-direction: column;
+    min-width: 0;
+    min-height: 0;
+}
+
+.topbar {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    height: var(--topbar-h);
+    padding: 0 20px;
+    flex: none;
+    border-bottom: 1px solid var(--border-soft);
+    background: rgba(9, 14, 28, 0.72);
+    backdrop-filter: blur(10px);
+}
+
+.topbar-title {
+    display: flex;
+    align-items: center;
+    gap: 9px;
+    min-width: 0;
+    padding: 6px 10px;
+    border-radius: var(--r-md);
+    border: 1px solid transparent;
+    font-size: 15px;
+    font-weight: 600;
+    transition: all var(--fast) var(--ease);
+}
+
+.topbar-title:hover { background: var(--surface-2); border-color: var(--border); }
+
+.topbar-title span {
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+    max-width: 380px;
+}
+
+.topbar-title .icon { width: 14px; height: 14px; color: var(--text-muted); flex: none; }
+
+.topbar-spacer { flex: 1; }
+
+.topbar-status {
+    display: flex;
+    align-items: center;
+    gap: 7px;
+    padding: 6px 12px;
+    border-radius: var(--r-pill);
+    background: var(--surface);
+    border: 1px solid var(--border-soft);
+    font-size: 12px;
+    color: var(--text-dim);
+    white-space: nowrap;
+}
+
+.topbar-status.off { color: var(--warn); border-color: rgba(251,191,36,0.32); background: var(--warn-soft); }
+
+/* Inline search over the current chat */
+.search-box {
+    position: relative;
+    flex: 0 1 240px;
+    min-width: 0;
+}
+
+.search-box .icon {
+    position: absolute;
+    left: 11px;
+    top: 50%;
+    transform: translateY(-50%);
+    width: 15px;
+    height: 15px;
+    opacity: 0.6;
+    pointer-events: none;
+}
+
+.search-box input {
+    width: 100%;
+    padding: 8px 32px 8px 34px;
+    border-radius: var(--r-pill);
+    background: var(--surface);
+    border: 1px solid var(--border-soft);
+    font-size: 13px;
+    transition: all var(--fast) var(--ease);
+}
+
+.search-box input:focus {
+    outline: none;
+    border-color: var(--accent);
+    box-shadow: 0 0 0 3px var(--accent-soft);
+    background: var(--surface-2);
+}
+
+.search-clear {
+    position: absolute;
+    right: 6px;
+    top: 50%;
+    transform: translateY(-50%);
+    display: grid;
+    place-items: center;
+    width: 22px;
+    height: 22px;
+    border-radius: 50%;
+    color: var(--text-muted);
+}
+
+.search-clear:hover { color: var(--text); background: var(--surface-3); }
+.search-clear .icon { position: static; transform: none; width: 12px; height: 12px; opacity: 1; }
+
+.search-count {
+    position: absolute;
+    right: 38px;
+    top: 50%;
+    transform: translateY(-50%);
+    font-size: 11px;
+    color: var(--text-muted);
+    pointer-events: none;
+}
+
+/* --------------------------------------------------------------------------
+   Message stream
+   -------------------------------------------------------------------------- */
+
+.stream {
+    flex: 1;
+    min-height: 0;
+    overflow-y: auto;
+    padding: 26px 0 12px;
+    scroll-behavior: smooth;
+}
+
+.stream-inner {
+    max-width: 820px;
+    margin: 0 auto;
+    padding: 0 24px;
+    display: flex;
+    flex-direction: column;
+    gap: 20px;
+}
+
+.msg { display: flex; flex-direction: column; gap: 8px; }
+
+.msg-head {
+    display: flex;
+    align-items: center;
+    gap: 9px;
+    font-size: 12px;
+    color: var(--text-muted);
+}
+
+.msg-head .who { font-weight: 600; color: var(--text-dim); }
+
+.msg-head .icon { width: 13px; height: 13px; opacity: 0.5; }
+
+.bubble {
+    padding: 14px 17px;
+    border-radius: var(--r-lg);
+    font-size: 14.5px;
+    line-height: 1.68;
+    overflow-wrap: anywhere;
+}
+
+.bubble-user {
+    align-self: flex-end;
+    max-width: 78%;
+    border-bottom-right-radius: 6px;
+    background: linear-gradient(140deg, rgba(56,189,248,0.17), rgba(56,189,248,0.09));
+    border: 1px solid var(--accent-line);
+}
+
+.bubble-ai {
+    align-self: flex-start;
+    max-width: 92%;
+    border-bottom-left-radius: 6px;
+    background: var(--surface);
+    border: 1px solid var(--border-soft);
+}
+
+.bubble p + p, .bubble ul + p, .bubble pre + p { margin-top: 10px; }
+.bubble ul, .bubble ol { margin: 8px 0; padding-left: 22px; list-style: disc; }
+.bubble ol { list-style: decimal; }
+.bubble li { margin: 3px 0; }
+.bubble h1, .bubble h2, .bubble h3, .bubble h4 { margin: 14px 0 8px; font-size: 16px; }
+.bubble hr { margin: 14px 0; border: none; border-top: 1px solid var(--border); }
+.bubble code {
+    padding: 2px 6px;
+    border-radius: 5px;
+    background: rgba(0, 0, 0, 0.32);
+    font-family: var(--font-mono);
+    font-size: 0.86em;
+}
+
+.bubble pre {
+    margin: 12px 0;
+    padding: 14px;
+    overflow-x: auto;
+    border-radius: var(--r-md);
+    background: #050A14;
+    border: 1px solid var(--border);
+}
+
+.bubble pre code { padding: 0; background: none; font-size: 12.5px; line-height: 1.6; }
+
+/* Message actions, revealed on hover so the stream stays calm */
+.msg-actions {
+    display: flex;
+    gap: 2px;
+    opacity: 0;
+    transition: opacity var(--fast) var(--ease);
+}
+
+.msg:hover .msg-actions, .msg-actions:focus-within { opacity: 1; }
+.msg.is-editing .msg-actions { opacity: 1; }
+
+.msg-actions .icon-btn { width: 28px; height: 28px; }
+.msg-actions .icon-btn .icon { width: 14px; height: 14px; }
+
+.msg-edit {
+    display: flex;
+    flex-direction: column;
+    gap: 9px;
+    max-width: 78%;
+    align-self: flex-end;
+}
+
+.msg-edit textarea {
+    width: 100%;
+    min-height: 82px;
+    padding: 12px 14px;
+    border-radius: var(--r-md);
+    background: var(--surface);
+    border: 1px solid var(--accent);
+    color: var(--text);
+    font-size: 14.5px;
+    line-height: 1.6;
+    resize: vertical;
+}
+
+.msg-edit textarea:focus { outline: none; box-shadow: 0 0 0 3px var(--accent-soft); }
+
+.msg-edit-actions { display: flex; justify-content: flex-end; gap: 8px; }
+
+/* Blocked / intercepted message card */
+.bubble-blocked {
+    align-self: flex-start;
+    max-width: 88%;
+    border-radius: var(--r-lg);
+    border: 1px solid rgba(248, 113, 113, 0.34);
+    background: var(--danger-soft);
+}
+
+.blocked-head {
+    display: flex;
+    align-items: center;
+    gap: 9px;
+    margin-bottom: 10px;
+    font-size: 13.5px;
+    font-weight: 600;
+    color: var(--danger);
+}
+
+.blocked-head .icon { width: 16px; height: 16px; flex: none; }
+
+.blocked-reason { font-size: 13.5px; color: var(--text-dim); line-height: 1.6; }
+
+.blocked-matches { margin-top: 12px; display: flex; flex-direction: column; gap: 6px; }
+
+.blocked-match {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 8px;
+    padding: 7px 10px;
+    border-radius: var(--r-sm);
+    background: rgba(0, 0, 0, 0.26);
+    font-size: 12.5px;
+}
+
+.blocked-match code {
+    padding: 2px 6px;
+    border-radius: 4px;
+    background: rgba(0, 0, 0, 0.4);
+    font-family: var(--font-mono);
+}
+
+.override-panel {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 9px;
+    margin-top: 14px;
+    padding-top: 14px;
+    border-top: 1px solid rgba(248, 113, 113, 0.24);
+}
+
+.override-panel input {
+    flex: 1 1 180px;
+    padding: 9px 12px;
+    border-radius: var(--r-sm);
+    background: var(--bg);
+    border: 1px solid var(--border);
+    font-size: 13px;
+}
+
+.override-panel input:focus { outline: none; border-color: var(--accent); }
+
+.override-note {
+    width: 100%;
+    font-size: 11.5px;
+    color: var(--text-muted);
+    line-height: 1.5;
+}
+
+/* Search highlight */
+mark {
+    padding: 0 2px;
+    border-radius: 3px;
+    background: rgba(251, 191, 36, 0.34);
+    color: #fff;
+}
+
+/* --------------------------------------------------------------------------
+   Composer
+   -------------------------------------------------------------------------- */
+
+.composer {
+    flex: none;
+    padding: 14px 24px 20px;
+    border-top: 1px solid var(--border-soft);
+    background: rgba(9, 14, 28, 0.72);
+    backdrop-filter: blur(10px);
+}
+
+.composer-inner {
+    max-width: 820px;
+    margin: 0 auto;
+}
+
+.composer-box {
+    display: flex;
+    align-items: flex-end;
+    gap: 10px;
+    padding: 10px 12px;
+    border-radius: var(--r-lg);
+    background: var(--surface);
+    border: 1px solid var(--border);
+    transition: border-color var(--fast) var(--ease), box-shadow var(--fast) var(--ease);
+}
+
+.composer-box:focus-within {
+    border-color: var(--accent);
+    box-shadow: 0 0 0 3px var(--accent-soft);
+}
+
+.composer-box textarea {
+    flex: 1;
+    max-height: 180px;
+    min-height: 26px;
+    padding: 6px 2px;
+    font-size: 14.5px;
+    line-height: 1.6;
+    resize: none;
+    background: none;
+}
+
+.composer-box textarea:focus { outline: none; }
+.composer-box textarea::placeholder { color: var(--text-muted); }
+
+.composer-send {
+    display: grid;
+    place-items: center;
+    width: 38px;
+    height: 38px;
+    flex: none;
+    border-radius: var(--r-md);
+    background: linear-gradient(180deg, #58CBFA, var(--accent));
+    color: #04121F;
+    transition: transform var(--fast) var(--ease), box-shadow var(--fast) var(--ease);
+}
+
+.composer-send:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(56,189,248,0.3); }
+.composer-send:disabled { opacity: 0.45; cursor: not-allowed; transform: none; box-shadow: none; }
+.composer-send .icon { width: 18px; height: 18px; }
+
+.composer-foot {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    max-width: 820px;
+    margin: 9px auto 0;
+    font-size: 11.5px;
+    color: var(--text-muted);
+}
+
+.composer-foot .icon { width: 13px; height: 13px; opacity: 0.7; }
+
+.composer-hint { margin-left: auto; font-family: var(--font-mono); font-size: 11px; }
+
+/* --------------------------------------------------------------------------
+   Responsive
+   -------------------------------------------------------------------------- */
+
+@media (max-width: 900px) {
+    .workspace { grid-template-columns: minmax(0, 1fr); }
+    .sidebar {
+        position: fixed;
+        z-index: 500;
+        top: 0; left: 0; bottom: 0;
+        width: var(--sidebar-w);
+        transform: translateX(-100%);
+        transition: transform var(--med) var(--ease);
+        box-shadow: var(--shadow-lg);
+    }
+    .sidebar.is-open { transform: none; }
+    .topbar-title span { max-width: 160px; }
+    .search-box { flex-basis: 150px; }
+}
+
+@media (max-width: 620px) {
+    .topbar { padding: 0 14px; }
+    .stream-inner { padding: 0 14px; }
+    .composer { padding: 12px 14px 16px; }
+    .bubble-user { max-width: 92%; }
+    .search-box { display: none; }
+}
diff --git a/src/static/js/auth.js b/src/static/js/auth.js
new file mode 100644
index 0000000..5d9ae96
--- /dev/null
+++ b/src/static/js/auth.js
@@ -0,0 +1,228 @@
+/* ==========================================================================
+   auth.js — the two-step sign-in portal.
+
+   Step 1: the administrator signs in. Step 2: a team member signs in, which
+   is what actually opens a workspace. The administrator token is kept
+   separately from the member token, because the two grant different powers.
+   ========================================================================== */
+
+(function () {
+    "use strict";
+
+    var Session = window.Api.Session;
+    var Loading = window.Loading;
+    var $ = window.Dom.$;
+
+    var admin = {
+        step: $("#admin-step"),
+        username: $("#admin-username"),
+        password: $("#admin-password"),
+        msg: $("#admin-msg"),
+        login: $("#btn-admin-login"),
+        register: $("#btn-admin-register"),
+        remove: $("#btn-admin-delete")
+    };
+
+    var employee = {
+        step: $("#employee-card"),
+        badge: $("#admin-session-badge"),
+        adminLabel: $("#active-admin-label"),
+        username: $("#employee-username"),
+        password: $("#employee-password"),
+        msg: $("#employee-msg"),
+        login: $("#btn-employee-login"),
+        create: $("#btn-employee-create"),
+        remove: $("#btn-employee-delete")
+    };
+
+    var parentId = null;
+
+    function showError(node, message) {
+        node.textContent = message || "";
+    }
+
+    /* ------------------------------------------------------------------
+       Step 1 — administrator
+       ------------------------------------------------------------------ */
+
+    function adminLogin() {
+        showError(admin.msg, "");
+        var username = admin.username.value.trim();
+        var password = admin.password.value;
+
+        if (!username || !password) {
+            showError(admin.msg, "Enter your username and password.");
+            admin.username.focus();
+            return;
+        }
+
+        Loading.withButton(admin.login, function () {
+            return window.Api.post("/api/admin/login",
+                { username: username, password: password },
+                { member: false, onUnauthorised: false });
+        }).then(function (data) {
+            parentId = parseInt(data.Parent_id, 10);
+            Session.setAdmin(data.session_token, {
+                parentId: parentId,
+                username: data.username || username
+            });
+            admin.password.value = "";
+            revealMemberStep(username);
+        }).catch(function (err) {
+            showError(admin.msg, err.message);
+            Loading.toast(err.message, "error");
+        });
+    }
+
+    /** Add or remove an administrator, using the credentials in step 1. */
+    function adminManage(method) {
+        var username = admin.username.value.trim();
+        var password = admin.password.value;
+        if (!username || !password) {
+            showError(admin.msg, "Fill in both fields first, then choose "
+                + (method === "add" ? "create" : "delete") + ".");
+            return;
+        }
+        var removing = method === "remove";
+        var confirmed = !removing || confirm(
+            "Delete the administrator '" + username + "'?\n\n"
+            + "Their team members, settings and history are removed with them. This cannot be undone."
+        );
+        if (!confirmed) return;
+
+        var button = removing ? admin.remove : admin.register;
+        Loading.withButton(button, function () {
+            return window.Api.post("/api/admin",
+                { method: method, username: username, password: password },
+                { member: false, onUnauthorised: false });
+        }).then(function () {
+            Loading.toast(removing ? "Administrator deleted." : "Administrator created. Sign in now.", "success");
+            if (removing) admin.password.value = "";
+        }).catch(function (err) {
+            showError(admin.msg, err.message);
+            Loading.toast(err.message, "error");
+        });
+    }
+
+    function revealMemberStep(username) {
+        admin.step.classList.add("hidden");
+        employee.step.classList.remove("hidden");
+        employee.badge.classList.remove("hidden");
+        employee.adminLabel.textContent = username;
+        employee.username.focus();
+    }
+
+    function backToAdmin() {
+        Session.clearAdmin();
+        Session.clearMember();
+        parentId = null;
+        employee.step.classList.add("hidden");
+        employee.badge.classList.add("hidden");
+        showError(employee.msg, "");
+        admin.step.classList.remove("hidden");
+        admin.username.focus();
+    }
+
+    /* ------------------------------------------------------------------
+       Step 2 — team member
+       ------------------------------------------------------------------ */
+
+    function employeeLogin() {
+        showError(employee.msg, "");
+        var username = employee.username.value.trim();
+        var password = employee.password.value;
+
+        if (!username || !password) {
+            showError(employee.msg, "Enter the team member's username and password.");
+            return;
+        }
+
+        Loading.withButton(employee.login, function () {
+            return window.Api.post("/api/admin/employee/login",
+                { Parent_id: parentId, username: username, password: password },
+                { member: false, onUnauthorised: false });
+        }).then(function (data) {
+            Session.setMember(data.session_token, {
+                parentId: parentId,
+                employeeId: parseInt(data.Employee_id, 10),
+                username: data.username || username
+            });
+            employee.password.value = "";
+            Loading.toast("Welcome back, " + (data.username || username) + ".", "success");
+            location.href = "/workspace";
+        }).catch(function (err) {
+            showError(employee.msg, err.message);
+            Loading.toast(err.message, "error");
+        });
+    }
+
+    /** Create or remove a team member under the signed-in administrator. */
+    function employeeManage(method) {
+        var username = employee.username.value.trim();
+        var password = employee.password.value;
+        if (!username || !password) {
+            showError(employee.msg, "Fill in both fields first, then choose "
+                + (method === "add" ? "add" : "remove") + ".");
+            return;
+        }
+        var removing = method === "remove";
+        var confirmed = !removing || confirm(
+            "Remove '" + username + "'?\n\nTheir chats and settings are removed. "
+            + "Team statistics are kept."
+        );
+        if (!confirmed) return;
+
+        var button = removing ? employee.remove : employee.create;
+        Loading.withButton(button, function () {
+            return window.Api.post("/api/admin/employee",
+                { method: method, Parent_id: parentId, username: username, password: password },
+                { member: false, onUnauthorised: false });
+        }).then(function () {
+            Loading.toast(removing ? "Team member removed." : "Team member added. Sign in now.", "success");
+            employee.password.value = "";
+        }).catch(function (err) {
+            showError(employee.msg, err.message);
+            Loading.toast(err.message, "error");
+        });
+    }
+
+    /* ------------------------------------------------------------------
+       Wiring
+       ------------------------------------------------------------------ */
+
+    window.Dom.on(admin.login, "click", adminLogin);
+    window.Dom.on(admin.register, "click", function () { adminManage("add"); });
+    window.Dom.on(admin.remove, "click", function () { adminManage("remove"); });
+
+    window.Dom.on(employee.login, "click", employeeLogin);
+    window.Dom.on(employee.create, "click", function () { employeeManage("add"); });
+    window.Dom.on(employee.remove, "click", function () { employeeManage("remove"); });
+    window.Dom.on($("#btn-admin-logout"), "click", backToAdmin);
+
+    [admin.username, admin.password].forEach(function (input) {
+        window.Dom.on(input, "keydown", function (e) {
+            if (e.key === "Enter") { e.preventDefault(); adminLogin(); }
+        });
+    });
+    [employee.username, employee.password].forEach(function (input) {
+        window.Dom.on(input, "keydown", function (e) {
+            if (e.key === "Enter") { e.preventDefault(); employeeLogin(); }
+        });
+    });
+
+    /* A remembered administrator skips straight to step 2. */
+    (function restore() {
+        var token = Session.getAdminToken();
+        var meta = Session.getAdmin();
+        if (!token || !meta || !meta.parentId) return;
+        window.Api.post("/api/admin/session", { token: token },
+            { member: false, onUnauthorised: false })
+            .then(function (data) {
+                if (!data.success) { Session.clearAdmin(); return; }
+                parentId = parseInt(data.Parent_id, 10);
+                Session.setAdmin(token, { parentId: parentId, username: data.username });
+                revealMemberStep(data.username || "administrator");
+            })
+            .catch(function () { Session.clearAdmin(); });
+    })();
+})();
diff --git a/src/static/js/core/api.js b/src/static/js/core/api.js
new file mode 100644
index 0000000..d1be41f
--- /dev/null
+++ b/src/static/js/core/api.js
@@ -0,0 +1,153 @@
+/* ==========================================================================
+   api.js — session storage and the one place that talks to the server.
+
+   Every page needs the same three facts (who is signed in, which workspace,
+   which member) and the same fetch wrapper. Putting them here means a page
