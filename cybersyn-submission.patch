+{% extends "base.html" %}
+
+{% block title %}Profile — CyberSyn{% endblock %}
+
+{% block styles %}
+<link rel="stylesheet" href="{{ url_for('static', filename='css/page.css') }}">
+{% endblock %}
+
+{% block body %}
+<div class="app-shell">
+    <div class="layout">
+        {% include "partials/sidebar.html" %}
+
+        <main class="layout-main">
+            <header class="page-head">
+                <div>
+                    <span class="eyebrow">Workspace</span>
+                    <h1>Profile</h1>
+                    <p class="dim">Your account and the workspace you belong to.</p>
+                </div>
+            </header>
+
+            <div class="page-body">
+
+                <section class="card">
+                    <div class="row" style="gap:16px">
+                        <span class="avatar" style="width:56px;height:56px;font-size:22px"
+                              data-member-avatar>M</span>
+                        <div>
+                            <h2 style="font-size:20px" data-member-name>Member</h2>
+                            <p class="small muted" data-workspace></p>
+                        </div>
+                    </div>
+                </section>
+
+                <section class="card">
+                    <div class="card-title"><span data-icon="history"></span> Account</div>
+                    <div class="rows">
+                        <div class="row-item">
+                            <span class="row-label">Username</span>
+                            <span class="row-value" id="info-username">—</span>
+                        </div>
+                        <div class="row-item">
+                            <span class="row-label">Member ID</span>
+                            <span class="row-value mono" id="info-employee-id">—</span>
+                        </div>
+                        <div class="row-item">
+                            <span class="row-label">Workspace ID</span>
+                            <span class="row-value mono" id="info-parent-id">—</span>
+                        </div>
+                        <div class="row-item">
+                            <span class="row-label">Safety checks enabled</span>
+                            <span class="row-value" id="info-checks">—</span>
+                        </div>
+                        <div class="row-item">
+                            <span class="row-label">Model</span>
+                            <span class="row-value mono" id="info-model">—</span>
+                        </div>
+                        <div class="row-item">
+                            <span class="row-label">API key</span>
+                            <span class="row-value mono" id="info-key">—</span>
+                        </div>
+                    </div>
+                </section>
+
+                <section class="card">
+                    <div class="card-title"><span data-icon="edit"></span> Change username</div>
+                    <form class="inline-form" id="form-username">
+                        <div class="field">
+                            <label for="input-username-new">New username</label>
+                            <input type="text" id="input-username-new" class="input"
+                                   autocomplete="off" required>
+                        </div>
+                        <div class="field">
+                            <label for="input-username-password">Current password</label>
+                            <input type="password" id="input-username-password" class="input"
+                                   autocomplete="current-password" required>
+                        </div>
+                        <button type="submit" class="btn btn-primary" id="btn-save-username">Save</button>
+                    </form>
+                    <div class="form-msg" id="msg-username"></div>
+                </section>
+
+                <section class="card">
+                    <div class="card-title"><span data-icon="lock"></span> Change password</div>
+                    <form class="inline-form" id="form-password">
+                        <div class="field">
+                            <label for="input-password-current">Current password</label>
+                            <input type="password" id="input-password-current" class="input"
+                                   autocomplete="current-password" required>
+                        </div>
+                        <div class="field">
+                            <label for="input-password-new">New password</label>
+                            <input type="password" id="input-password-new" class="input"
+                                   autocomplete="new-password" required>
+                        </div>
+                        <button type="submit" class="btn btn-primary" id="btn-save-password">Save</button>
+                    </form>
+                    <div class="form-msg" id="msg-password"></div>
+                </section>
+
+            </div>
+        </main>
+    </div>
+</div>
+{% endblock %}
+
+{% block scripts %}
+<script src="{{ url_for('static', filename='js/profile.js') }}"></script>
+{% endblock %}
