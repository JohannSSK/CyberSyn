diff --git a/src/static/css/auth.css b/src/static/css/auth.css
new file mode 100644
index 0000000..fabb609
--- /dev/null
+++ b/src/static/css/auth.css
@@ -0,0 +1,289 @@
+/* ==========================================================================
+   auth.css — the sign-in portal.
+
+   This screen is deliberately its own thing: a warm, near-black split panel,
+   quieter than the app it opens into. The layout, proportions and palette
+   are the original design and are kept as-is — only the button loading
+   state is new, because every action in the app gives feedback.
+
+   Everything is scoped to .auth-shell so the rest of the app keeps its
+   cool navy palette and nothing leaks between the two.
+   ========================================================================== */
+
+.auth-shell {
+    --auth-ink: #1c1917;
+    --auth-ink-soft: #a8a29e;
+    --auth-panel-bg: #2a2926;
+    --auth-panel-2: #33322f;
+    --auth-field-bg: #1f1e1c;
+    --auth-line: #46443f;
+    --auth-text: #ecebe7;
+    --auth-muted: #a8a59d;
+    --auth-danger: #e8a09a;
+
+    display: grid;
+    grid-template-columns: minmax(340px, 5fr) 7fr;
+    align-items: stretch;
+    width: 100%;
+    min-height: 100vh;
+    background: var(--auth-ink);
+    color: var(--auth-text);
+}
+
+.auth-shell .hidden { display: none !important; }
+
+/* ---- left: brand ---- */
+
+.auth-brand {
+    display: flex;
+    flex-direction: column;
+    justify-content: space-between;
+    gap: 40px;
+    padding: 48px 56px;
+    background: var(--auth-ink);
+    color: #fafaf9;
+}
+
+.auth-logo {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    font-size: 20px;
+    font-weight: 600;
+    letter-spacing: 0.02em;
+}
+
+.auth-logo .icon { width: 28px; height: 28px; color: var(--auth-text); }
+
+.auth-brand-body h2 {
+    margin: 0 0 16px;
+    font-size: 30px;
+    line-height: 1.25;
+    font-weight: 600;
+    letter-spacing: -0.01em;
+    color: #fafaf9;
+}
+
+.auth-brand-body > p {
+    margin: 0 0 32px;
+    max-width: 440px;
+    font-size: 15px;
+    line-height: 1.65;
+    color: var(--auth-ink-soft);
+}
+
+.auth-points {
+    display: flex;
+    flex-direction: column;
+    gap: 20px;
+    max-width: 440px;
+}
+
+.auth-points li {
+    display: flex;
+    flex-direction: column;
+    gap: 4px;
+    padding-left: 16px;
+    border-left: 2px solid #57534e;
+}
+
+.auth-points strong { font-size: 14px; font-weight: 600; color: #fafaf9; }
+
+.auth-points span { font-size: 13px; line-height: 1.55; color: var(--auth-ink-soft); }
+
+.auth-brand-foot { font-size: 12px; letter-spacing: 0.04em; color: #78716c; }
+
+/* ---- right: the form ---- */
+
+.auth-panel {
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    padding: 48px 32px;
+    background: var(--auth-panel-bg);
+}
+
+.auth-step {
+    width: 100%;
+    max-width: 400px;
+    animation: authFadeIn 0.3s ease;
+}
+
+@keyframes authFadeIn {
+    from { opacity: 0; transform: translateY(6px); }
+    to   { opacity: 1; transform: translateY(0); }
+}
+
+.auth-progress { display: flex; gap: 6px; margin-bottom: 28px; }
+
+.auth-progress span {
+    flex: 1;
+    height: 3px;
+    border-radius: 2px;
+    background: var(--auth-line);
+}
+
+.auth-progress span.is-active { background: #ecebe7; }
+
+.auth-eyebrow {
+    margin-bottom: 10px;
+    font-size: 12px;
+    font-weight: 600;
+    letter-spacing: 0.08em;
+    text-transform: uppercase;
+    color: var(--auth-muted);
+}
+
+.auth-title {
+    margin: 0 0 10px;
+    font-size: 28px;
+    line-height: 1.2;
+    font-weight: 600;
+    letter-spacing: -0.015em;
+    color: #ecebe7;
+}
+
+.auth-lead {
+    margin: 0 0 28px;
+    font-size: 15px;
+    line-height: 1.6;
+    color: var(--auth-muted);
+}
+
+.auth-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 18px; }
+
+.auth-field label { font-size: 13px; font-weight: 600; color: #d6d3cc; }
+
+.auth-field input {
+    width: 100%;
+    box-sizing: border-box;
+    padding: 12px 14px;
+    font-size: 15px;
+    font-family: inherit;
+    color: var(--auth-text);
+    background: var(--auth-field-bg);
+    border: 1px solid var(--auth-line);
+    border-radius: 8px;
+    outline: none;
+    transition: border-color 0.15s ease, box-shadow 0.15s ease;
+}
+
+.auth-field input::placeholder { color: #7d7a72; }
+
+.auth-field input:focus {
+    border-color: #ecebe7;
+    box-shadow: 0 0 0 3px rgba(236, 235, 231, 0.12);
+}
+
+.auth-inline-msg {
+    min-height: 1em;
+    margin: -6px 0 12px;
+    font-size: 13px;
+    line-height: 1.4;
+    color: var(--auth-danger);
+}
+
+/* Primary action: light on dark, the one high-contrast element on the page. */
+.auth-btn-primary {
+    position: relative;
+    width: 100%;
+    margin-top: 6px;
+    padding: 13px 16px;
+    font-size: 15px;
+    font-weight: 600;
+    font-family: inherit;
+    color: #1f1e1c;
+    background: #ecebe7;
+    border: 1px solid #ecebe7;
+    border-radius: 8px;
+    cursor: pointer;
+    transition: background 0.15s ease, transform 0.05s ease;
+}
+
+.auth-btn-primary:hover { background: #ffffff; }
+.auth-btn-primary:active { transform: translateY(1px); }
+.auth-btn-primary:focus-visible { outline: 2px solid #ecebe7; outline-offset: 2px; }
+.auth-btn-primary:disabled { opacity: 0.85; cursor: progress; }
+
+/* The spinner is dark, because this button is light. */
+.auth-btn-primary .btn-spinner::after {
+    border-color: rgba(0, 0, 0, 0.25);
+    border-top-color: #1f1e1c;
+}
+
+.auth-secondary {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    gap: 16px;
+    margin-top: 22px;
+    padding-top: 20px;
+    border-top: 1px solid var(--auth-line);
+}
+
+.auth-link {
+    padding: 0;
+    font-size: 13px;
+    font-weight: 500;
+    font-family: inherit;
+    color: var(--auth-muted);
+    background: none;
+    border: none;
+    cursor: pointer;
+    text-decoration: none;
+    transition: color 0.15s ease;
+}
+
+.auth-link:hover { color: #ecebe7; text-decoration: underline; }
+.auth-link-danger:hover { color: var(--auth-danger); }
+
+.auth-context {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    gap: 16px;
+    padding: 14px 16px;
+    margin-bottom: 22px;
+    background: var(--auth-panel-2);
+    border: 1px solid rgba(255, 255, 255, 0.06);
+    border-radius: 8px;
+}
+
+.auth-context-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
+
+.auth-context-label {
+    font-size: 11px;
+    font-weight: 600;
+    letter-spacing: 0.06em;
+    text-transform: uppercase;
+    color: var(--auth-muted);
+}
+
+.auth-context-text strong {
+    font-size: 14px;
+    color: #ecebe7;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.auth-context-actions { display: flex; flex-direction: column; gap: 4px; align-items: flex-end; }
+
+.auth-footnote {
+    width: 100%;
+    max-width: 400px;
+    margin-top: 40px;
+    font-size: 12px;
+    line-height: 1.6;
+    color: #a8a29e;
+    text-align: center;
+}
+
+@media (max-width: 860px) {
+    .auth-shell { grid-template-columns: 1fr; }
+    .auth-brand { padding: 28px 24px; gap: 16px; }
+    .auth-brand-body h2 { font-size: 22px; margin-bottom: 0; }
+    .auth-brand-body > p, .auth-points, .auth-brand-foot { display: none; }
+    .auth-panel { padding: 36px 24px; justify-content: flex-start; }
+}
diff --git a/src/static/css/base.css b/src/static/css/base.css
new file mode 100644
index 0000000..051bd31
--- /dev/null
+++ b/src/static/css/base.css
@@ -0,0 +1,245 @@
+/* ==========================================================================
+   base.css — design tokens, reset, typography, layout primitives.
+   Every other stylesheet builds on these variables; none of them redefine
+   a colour or a font that lives here.
+   ========================================================================== */
+
+:root {
+    /* Surfaces, darkest to lightest */
+    --bg:            #080D19;
+    --bg-grad-a:     #0B1224;
+    --bg-grad-b:     #101A33;
+    --surface:       #111A2E;
+    --surface-2:     #17223B;
+    --surface-3:     #1E2B49;
+    --border:        #26334F;
+    --border-soft:   #1C2740;
+
+    /* Text */
+    --text:          #E8EEF9;
+    --text-dim:      #A9B8D4;
+    --text-muted:    #7488AC;
+
+    /* Accent + status */
+    --accent:        #38BDF8;
+    --accent-deep:   #0EA5E9;
+    --accent-soft:   rgba(56, 189, 248, 0.14);
+    --accent-line:   rgba(56, 189, 248, 0.38);
+    --violet:        #A78BFA;
+    --success:       #34D399;
+    --success-soft:  rgba(52, 211, 153, 0.14);
+    --warn:          #FBBF24;
+    --warn-soft:     rgba(251, 191, 36, 0.14);
+    --danger:        #F87171;
+    --danger-soft:   rgba(248, 113, 113, 0.14);
+
+    /* Geometry */
+    --r-sm: 8px;
+    --r-md: 12px;
+    --r-lg: 16px;
+    --r-xl: 22px;
+    --r-pill: 999px;
+
+    /* Elevation */
+    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4);
+    --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.36);
+    --shadow-lg: 0 24px 64px rgba(0, 0, 0, 0.55);
+    --glow: 0 0 0 1px var(--accent-line), 0 8px 30px rgba(56, 189, 248, 0.18);
+
+    /* Type */
+    --font: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
+    --font-display: "Instrument Serif", "Inter", Georgia, serif;
+    --font-mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
+
+    /* Motion */
+    --ease: cubic-bezier(0.22, 1, 0.36, 1);
+    --fast: 140ms;
+    --med: 240ms;
+    --slow: 420ms;
+
+    --sidebar-w: 268px;
+    --topbar-h: 66px;
+}
+
+/* --------------------------------------------------------------------------
+   Reset
+   -------------------------------------------------------------------------- */
+
+*,
+*::before,
+*::after { box-sizing: border-box; }
+
+* { margin: 0; padding: 0; }
+
+html, body { height: 100%; }
+
+body {
+    font-family: var(--font);
+    font-size: 15px;
+    line-height: 1.6;
+    color: var(--text);
+    background: var(--bg);
+    -webkit-font-smoothing: antialiased;
+    -moz-osx-font-smoothing: grayscale;
+    overflow-x: hidden;
+}
+
+/* The app is always dark: light-system themes must not wash it out. */
+:root { color-scheme: dark; }
+
+img, svg { display: block; max-width: 100%; }
+
+button, input, select, textarea {
+    font: inherit;
+    color: inherit;
+    background: none;
+    border: none;
+}
+
+button { cursor: pointer; }
+
+button:disabled { cursor: not-allowed; }
+
+a { color: var(--accent); text-decoration: none; }
+
+a:hover { text-decoration: underline; }
+
+ul, ol { list-style: none; }
+
+::selection { background: var(--accent-soft); color: #fff; }
+
+:focus-visible {
+    outline: 2px solid var(--accent);
+    outline-offset: 2px;
+    border-radius: 4px;
+}
+
+/* --------------------------------------------------------------------------
+   Typography
+   -------------------------------------------------------------------------- */
+
+h1, h2, h3, h4 { font-weight: 600; line-height: 1.25; letter-spacing: -0.01em; }
+
+h1 { font-size: 30px; }
+h2 { font-size: 23px; }
+h3 { font-size: 18px; }
+h4 { font-size: 15px; }
+
+.display { font-family: var(--font-display); font-weight: 400; letter-spacing: -0.02em; }
+
+.mono { font-family: var(--font-mono); font-variant-ligatures: none; }
+
+.muted { color: var(--text-muted); }
+
+.dim { color: var(--text-dim); }
+
+.small { font-size: 13px; }
+
+.tiny { font-size: 12px; }
+
+.eyebrow {
+    font-size: 11px;
+    font-weight: 600;
+    letter-spacing: 0.12em;
+    text-transform: uppercase;
+    color: var(--accent);
+}
+
+/* --------------------------------------------------------------------------
+   Layout primitives
+   -------------------------------------------------------------------------- */
+
+.app-shell {
+    position: relative;
+    min-height: 100vh;
+    background:
+        radial-gradient(1100px 620px at 12% -8%, rgba(56, 189, 248, 0.10), transparent 60%),
+        radial-gradient(900px 520px at 96% 4%, rgba(167, 139, 250, 0.09), transparent 62%),
+        linear-gradient(168deg, var(--bg-grad-a), var(--bg-grad-b) 55%, var(--bg));
+}
+
+.page {
+    max-width: 1180px;
+    margin: 0 auto;
+    padding: 34px 26px 72px;
+}
+
+.page-narrow {
+    max-width: 780px;
+    margin: 0 auto;
+    padding: 34px 26px 72px;
+}
+
+.stack      { display: flex; flex-direction: column; gap: 14px; }
+.stack-sm   { display: flex; flex-direction: column; gap: 8px; }
+.stack-lg   { display: flex; flex-direction: column; gap: 26px; }
+.row        { display: flex; align-items: center; gap: 10px; }
+.row-between{ display: flex; align-items: center; justify-content: space-between; gap: 14px; }
+.wrap       { flex-wrap: wrap; }
+.grow       { flex: 1; min-width: 0; }
+.center     { text-align: center; }
+
+.grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
+.grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
+.grid-4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
+
+@media (max-width: 900px) {
+    .grid-3, .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+
+@media (max-width: 620px) {
+    .grid-2, .grid-3, .grid-4 { grid-template-columns: minmax(0, 1fr); }
+    .page, .page-narrow { padding: 22px 16px 60px; }
+}
+
+.hidden { display: none !important; }
+
+.sr-only {
+    position: absolute;
+    width: 1px; height: 1px;
+    padding: 0; margin: -1px;
+    overflow: hidden; clip: rect(0 0 0 0);
+    white-space: nowrap; border: 0;
+}
+
+/* --------------------------------------------------------------------------
+   Scrollbars
+   -------------------------------------------------------------------------- */
+
+* { scrollbar-width: thin; scrollbar-color: var(--surface-3) transparent; }
+
+::-webkit-scrollbar { width: 10px; height: 10px; }
+
+::-webkit-scrollbar-track { background: transparent; }
+
+::-webkit-scrollbar-thumb {
+    background: var(--surface-3);
+    border: 3px solid transparent;
+    border-radius: var(--r-pill);
+    background-clip: content-box;
+}
+
+::-webkit-scrollbar-thumb:hover { background: #2C3C63; background-clip: content-box; }
+
+/* --------------------------------------------------------------------------
+   Motion
+   -------------------------------------------------------------------------- */
+
+@keyframes fade-in   { from { opacity: 0; } to { opacity: 1; } }
+@keyframes rise-in   { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
+@keyframes scale-in  { from { opacity: 0; transform: scale(0.97); } to { opacity: 1; transform: none; } }
+@keyframes spin      { to { transform: rotate(360deg); } }
+@keyframes shimmer   { 100% { transform: translateX(100%); } }
+@keyframes pulse-dim { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }
+@keyframes draw-ring { to { stroke-dashoffset: 0; } }
+
+.rise-in { animation: rise-in var(--med) var(--ease) both; }
+.fade-in { animation: fade-in var(--med) var(--ease) both; }
+
+@media (prefers-reduced-motion: reduce) {
+    *, *::before, *::after {
+        animation-duration: 0.01ms !important;
+        animation-iteration-count: 1 !important;
+        transition-duration: 0.01ms !important;
+    }
+}
diff --git a/src/static/css/components.css b/src/static/css/components.css
new file mode 100644
index 0000000..9569a56
--- /dev/null
+++ b/src/static/css/components.css
@@ -0,0 +1,607 @@
+/* ==========================================================================
+   components.css — buttons, fields, cards, toasts, modals, loading states.
+   Reusable pieces only. Nothing here knows about a specific page.
+   ========================================================================== */
+
+/* --------------------------------------------------------------------------
+   Buttons
+   -------------------------------------------------------------------------- */
+
+.btn {
+    position: relative;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: 9px;
+    padding: 11px 18px;
+    border-radius: var(--r-md);
+    font-size: 14px;
+    font-weight: 600;
+    color: var(--text);
+    background: var(--surface-2);
+    border: 1px solid var(--border);
+    transition: background var(--fast) var(--ease),
+                border-color var(--fast) var(--ease),
+                transform var(--fast) var(--ease),
+                box-shadow var(--fast) var(--ease);
+    white-space: nowrap;
+    user-select: none;
+}
+
+.btn:hover:not(:disabled) {
+    background: var(--surface-3);
+    border-color: #30406A;
+    transform: translateY(-1px);
+}
+
+.btn:active:not(:disabled) { transform: translateY(0) scale(0.985); }
+
+.btn:disabled { opacity: 0.5; }
+
+.btn-primary {
+    color: #04121F;
+    background: linear-gradient(180deg, #58CBFA, var(--accent));
+    border-color: transparent;
+    box-shadow: 0 6px 18px rgba(56, 189, 248, 0.24);
+}
+
+.btn-primary:hover:not(:disabled) {
+    background: linear-gradient(180deg, #6FD3FB, #2BB4EE);
+    box-shadow: 0 10px 26px rgba(56, 189, 248, 0.34);
+}
+
+.btn-ghost { background: transparent; border-color: transparent; color: var(--text-dim); }
+.btn-ghost:hover:not(:disabled) { background: var(--surface-2); color: var(--text); border-color: var(--border-soft); }
+
+.btn-outline { background: transparent; border-color: var(--border); }
+.btn-outline:hover:not(:disabled) { background: var(--surface-2); }
+
+.btn-danger { color: #fff; background: linear-gradient(180deg, #F97C7C, #E14B4B); border-color: transparent; }
+.btn-danger:hover:not(:disabled) { background: linear-gradient(180deg, #FB8F8F, #EC5A5A); }
+
+.btn-outline-danger { color: var(--danger); background: transparent; border-color: rgba(248, 113, 113, 0.45); }
+.btn-outline-danger:hover:not(:disabled) { background: var(--danger-soft); border-color: var(--danger); }
+
+.btn-warning { color: #241A02; background: linear-gradient(180deg, #FCC94D, #F0A81E); border-color: transparent; }
+.btn-warning:hover:not(:disabled) { background: linear-gradient(180deg, #FDD268, #F3B333); }
+
+.btn-sm { padding: 7px 13px; font-size: 13px; border-radius: var(--r-sm); }
+.btn-lg { padding: 14px 24px; font-size: 15px; }
+.btn-block { width: 100%; }
+
+.btn-link {
+    padding: 0;
+    background: none;
+    border: none;
+    color: var(--accent);
+    font-size: 13px;
+    font-weight: 600;
+}
+
+.btn-link:hover { text-decoration: underline; }
+
+.btn-link.danger { color: var(--danger); }
+
+/* Icons inside buttons */
+.btn .icon { width: 17px; height: 17px; flex: none; }
+
+.btn-sm .icon { width: 15px; height: 15px; }
+
+/* --------------------------------------------------------------------------
+   Button loading state
+   Every action button shows its own spinner while its request is in flight,
+   and locks so a double-click cannot fire the same action twice.
+   -------------------------------------------------------------------------- */
+
+.btn.is-loading {
+    color: transparent !important;
+    pointer-events: none;
+    position: relative;
+}
+
+.btn.is-loading .icon,
+.btn.is-loading > *:not(.btn-spinner) { opacity: 0; }
+
+.btn-spinner {
+    position: absolute;
+    inset: 0;
+    display: none;
+    align-items: center;
+    justify-content: center;
+}
+
+.btn.is-loading .btn-spinner { display: flex; }
+
+.btn-spinner::after {
+    content: "";
+    width: 16px;
+    height: 16px;
+    border: 2px solid rgba(255, 255, 255, 0.28);
+    border-top-color: currentColor;
+    border-radius: 50%;
+    animation: spin 620ms linear infinite;
+    color: var(--text);
+}
+
+.btn-primary.is-loading .btn-spinner::after,
+.btn-danger.is-loading .btn-spinner::after,
+.btn-warning.is-loading .btn-spinner::after {
+    border-color: rgba(0, 0, 0, 0.25);
+    border-top-color: #06121F;
+}
+
+/* --------------------------------------------------------------------------
+   Fields
+   -------------------------------------------------------------------------- */
+
+.field { display: flex; flex-direction: column; gap: 7px; }
+
+.field > label {
+    font-size: 12px;
+    font-weight: 600;
+    letter-spacing: 0.04em;
+    text-transform: uppercase;
+    color: var(--text-muted);
+}
+
+.input,
+.select,
+.textarea {
+    width: 100%;
+    padding: 12px 14px;
+    border-radius: var(--r-md);
+    background: var(--surface);
+    border: 1px solid var(--border);
+    color: var(--text);
+    transition: border-color var(--fast) var(--ease),
+                box-shadow var(--fast) var(--ease),
+                background var(--fast) var(--ease);
+}
+
+.input::placeholder, .textarea::placeholder { color: var(--text-muted); }
+
+.input:focus, .select:focus, .textarea:focus {
+    outline: none;
+    border-color: var(--accent);
+    box-shadow: 0 0 0 3px var(--accent-soft);
+}
+
+.textarea { resize: vertical; min-height: 84px; }
+
+.select {
+    appearance: none;
+    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%237488AC' stroke-width='2.2' stroke-linecap='round'><path d='M6 9l6 6 6-6'/></svg>");
+    background-repeat: no-repeat;
+    background-position: right 13px center;
+    padding-right: 38px;
+    cursor: pointer;
+}
+
+.select option { background: var(--surface-2); color: var(--text); }
+
+.hint { font-size: 12px; color: var(--text-muted); }
+
+/* Input with a leading icon */
+.input-icon { position: relative; }
+
+.input-icon .icon {
+    position: absolute;
+    left: 13px;
+    top: 50%;
+    transform: translateY(-50%);
+    width: 17px;
+    height: 17px;
+    opacity: 0.75;
+    pointer-events: none;
+}
+
+.input-icon .input { padding-left: 40px; }
+
+/* --------------------------------------------------------------------------
+   Toggle switch
+   -------------------------------------------------------------------------- */
+
+.toggle {
+    display: flex;
+    align-items: flex-start;
+    gap: 13px;
+    padding: 13px 15px;
+    border-radius: var(--r-md);
+    border: 1px solid var(--border-soft);
+    background: var(--surface);
+    cursor: pointer;
+    transition: border-color var(--fast) var(--ease), background var(--fast) var(--ease);
+}
+
+.toggle:hover { border-color: var(--border); background: var(--surface-2); }
+
+.toggle input { position: absolute; opacity: 0; width: 0; height: 0; }
+
+.toggle-track {
+    position: relative;
+    flex: none;
+    width: 42px;
+    height: 24px;
+    margin-top: 1px;
+    border-radius: var(--r-pill);
+    background: var(--surface-3);
+    border: 1px solid var(--border);
+    transition: background var(--med) var(--ease), border-color var(--med) var(--ease);
+}
+
+.toggle-track::after {
+    content: "";
+    position: absolute;
+    top: 2px;
+    left: 2px;
+    width: 18px;
+    height: 18px;
+    border-radius: 50%;
+    background: var(--text-muted);
+    transition: transform var(--med) var(--ease), background var(--med) var(--ease);
+}
+
+.toggle input:checked + .toggle-track {
+    background: var(--accent-soft);
+    border-color: var(--accent);
+}
+
+.toggle input:checked + .toggle-track::after {
+    transform: translateX(18px);
+    background: var(--accent);
+}
+
+.toggle input:focus-visible + .toggle-track { box-shadow: 0 0 0 3px var(--accent-soft); }
+
+.toggle-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
+
+.toggle-body strong { font-size: 14px; font-weight: 600; }
+
+.toggle-body small { font-size: 12.5px; color: var(--text-muted); line-height: 1.45; }
+
+/* --------------------------------------------------------------------------
+   Cards
+   -------------------------------------------------------------------------- */
+
+.card {
+    padding: 20px;
+    border-radius: var(--r-lg);
+    background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.012));
+    border: 1px solid var(--border-soft);
+    box-shadow: var(--shadow-sm);
+}
+
+.card-title {
+    display: flex;
+    align-items: center;
+    gap: 9px;
+    margin-bottom: 14px;
+    font-size: 14px;
+    font-weight: 600;
+}
+
+.card-title .icon { width: 17px; height: 17px; color: var(--accent); }
+
+/* --------------------------------------------------------------------------
+   Badges
+   -------------------------------------------------------------------------- */
+
+.badge {
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+    padding: 4px 10px;
+    border-radius: var(--r-pill);
+    font-size: 11.5px;
+    font-weight: 600;
+    letter-spacing: 0.02em;
+    background: var(--surface-2);
+    border: 1px solid var(--border);
+    color: var(--text-dim);
+}
+
+.badge-accent { background: var(--accent-soft); border-color: var(--accent-line); color: var(--accent); }
+.badge-success { background: var(--success-soft); border-color: rgba(52,211,153,0.4); color: var(--success); }
+.badge-warn { background: var(--warn-soft); border-color: rgba(251,191,36,0.4); color: var(--warn); }
+.badge-danger { background: var(--danger-soft); border-color: rgba(248,113,113,0.4); color: var(--danger); }
+
+.dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; flex: none; }
+
+.dot-live { box-shadow: 0 0 0 0 currentColor; animation: pulse-dot 2.2s infinite; }
+
+@keyframes pulse-dot {
+    0%   { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.55); }
+    70%  { box-shadow: 0 0 0 7px rgba(52, 211, 153, 0); }
+    100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0); }
+}
+
+/* --------------------------------------------------------------------------
+   Icon buttons
+   -------------------------------------------------------------------------- */
+
+.icon-btn {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    width: 32px;
+    height: 32px;
+    border-radius: var(--r-sm);
+    color: var(--text-muted);
+    background: transparent;
+    border: 1px solid transparent;
+    transition: all var(--fast) var(--ease);
+}
+
+.icon-btn:hover {
+    color: var(--text);
+    background: var(--surface-2);
+    border-color: var(--border);
+}
+
+.icon-btn.danger:hover { color: var(--danger); background: var(--danger-soft); border-color: rgba(248,113,113,0.35); }
+.icon-btn .icon { width: 16px; height: 16px; }
+
+.icon-btn.is-loading { pointer-events: none; }
+.icon-btn.is-loading .icon { opacity: 0; }
+
+/* --------------------------------------------------------------------------
+   Toasts
+   -------------------------------------------------------------------------- */
+
+.toast-container {
+    position: fixed;
+    top: 18px;
+    right: 18px;
+    z-index: 9000;
+    display: flex;
+    flex-direction: column;
+    gap: 10px;
+    pointer-events: none;
+}
+
+.toast {
+    display: flex;
+    align-items: flex-start;
+    gap: 11px;
+    min-width: 280px;
+    max-width: 400px;
+    padding: 13px 15px;
+    border-radius: var(--r-md);
+    background: var(--surface-2);
+    border: 1px solid var(--border);
+    box-shadow: var(--shadow-md);
+    font-size: 13.5px;
+    pointer-events: auto;
+    animation: toast-in var(--med) var(--ease) both;
+}
+
+.toast.out { animation: toast-out var(--med) var(--ease) both; }
+
+@keyframes toast-in  { from { opacity: 0; transform: translateX(24px) scale(0.97); } to { opacity: 1; transform: none; } }
+@keyframes toast-out { to { opacity: 0; transform: translateX(24px) scale(0.97); } }
+
+.toast .icon { width: 17px; height: 17px; flex: none; margin-top: 1px; }
+.toast-success { border-color: rgba(52,211,153,0.4); } .toast-success .icon { color: var(--success); }
+.toast-error   { border-color: rgba(248,113,113,0.4); } .toast-error   .icon { color: var(--danger); }
+.toast-warn    { border-color: rgba(251,191,36,0.4); } .toast-warn    .icon { color: var(--warn); }
+.toast-info .icon { color: var(--accent); }
+
+/* --------------------------------------------------------------------------
+   Modal / overlay
+   -------------------------------------------------------------------------- */
+
+.overlay {
+    position: fixed;
+    inset: 0;
+    z-index: 8000;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    padding: 22px;
+    background: rgba(4, 8, 18, 0.72);
+    backdrop-filter: blur(6px);
+    animation: fade-in var(--fast) var(--ease) both;
+}
+
+.overlay.out { animation: fade-in var(--fast) var(--ease) reverse both; }
+
+.modal {
+    width: 100%;
+    max-width: 560px;
+    max-height: 88vh;
+    overflow-y: auto;
+    border-radius: var(--r-xl);
+    background: var(--surface);
+    border: 1px solid var(--border);
+    box-shadow: var(--shadow-lg);
+    animation: scale-in var(--med) var(--ease) both;
+}
+
+.modal-head {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 14px;
+    padding: 20px 22px;
+    border-bottom: 1px solid var(--border-soft);
+}
+
+.modal-body { padding: 22px; }
+.modal-foot {
+    display: flex;
+    justify-content: flex-end;
+    gap: 10px;
+    padding: 16px 22px;
+    border-top: 1px solid var(--border-soft);
+}
+
+.btn-close {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    width: 32px;
+    height: 32px;
+    border-radius: var(--r-sm);
+    font-size: 22px;
+    line-height: 1;
+    color: var(--text-muted);
+    background: transparent;
+    transition: all var(--fast) var(--ease);
+}
+
+.btn-close:hover { color: var(--text); background: var(--surface-2); }
+
+/* --------------------------------------------------------------------------
+   Skeleton loading
+   -------------------------------------------------------------------------- */
+
+.skeleton {
+    position: relative;
+    overflow: hidden;
+    background: var(--surface-2);
+    border-radius: var(--r-sm);
+}
+
+.skeleton::after {
+    content: "";
+    position: absolute;
+    inset: 0;
+    transform: translateX(-100%);
+    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.055), transparent);
+    animation: shimmer 1.5s infinite;
+}
+
+/* --------------------------------------------------------------------------
+   Empty state
+   -------------------------------------------------------------------------- */
+
+.empty {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    gap: 12px;
+    padding: 54px 24px;
+    text-align: center;
+    color: var(--text-muted);
+}
+
+.empty .icon { width: 40px; height: 40px; opacity: 0.4; }
+
+.empty h3 { color: var(--text-dim); font-size: 17px; }
+
+.empty p { max-width: 420px; font-size: 13.5px; }
+
+/* --------------------------------------------------------------------------
+   Full-screen scanning overlay
+   -------------------------------------------------------------------------- */
+
+.scan-overlay {
+    position: fixed;
+    inset: 0;
+    z-index: 8500;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    padding: 22px;
+    background: rgba(4, 8, 18, 0.78);
+    backdrop-filter: blur(8px);
+    animation: fade-in var(--fast) var(--ease) both;
+}
+
+.scan-card {
+    width: 100%;
+    max-width: 470px;
+    padding: 32px;
+    text-align: center;
+    border-radius: var(--r-xl);
+    background: var(--surface);
+    border: 1px solid var(--border);
+    box-shadow: var(--shadow-lg);
+    animation: scale-in var(--med) var(--ease) both;
+}
+
+.scan-ring {
+    position: relative;
+    width: 72px;
+    height: 72px;
+    margin: 0 auto 20px;
+}
+
+.scan-ring svg.ring {
+    width: 100%;
+    height: 100%;
+    transform: rotate(-90deg);
+}
+
+.scan-ring .ring circle {
+    fill: none;
+    stroke-width: 3;
+    stroke-linecap: round;
+}
+
+.scan-ring .ring .track { stroke: var(--surface-3); }
+
+.scan-ring .ring .bar {
+    stroke: var(--accent);
+    stroke-dasharray: 176;
+    stroke-dashoffset: 176;
+    animation: draw-ring 1.35s var(--ease) infinite;
+}
+
+.scan-ring .glyph {
+    position: absolute;
+    inset: 0;
+    display: grid;
+    place-items: center;
+    color: var(--accent);
+}
+
+.scan-ring .glyph .icon { width: 27px; height: 27px; }
+
+.scan-steps {
+    display: flex;
+    flex-direction: column;
+    gap: 3px;
+    margin: 22px 0 16px;
+    text-align: left;
+}
+
+.scan-step {
+    display: flex;
+    align-items: center;
+    gap: 11px;
+    padding: 9px 11px;
+    border-radius: var(--r-sm);
+    opacity: 0.4;
+    transition: opacity var(--med) var(--ease), background var(--med) var(--ease);
+}
+
+.scan-step.active { opacity: 1; background: var(--surface-2); }
+.scan-step.done   { opacity: 0.72; }
+
+.scan-step .mark {
+    display: grid;
+    place-items: center;
+    width: 19px;
+    height: 19px;
+    flex: none;
+    border-radius: 50%;
+    border: 2px solid var(--border);
+    font-size: 11px;
+    color: var(--success);
+}
+
+.scan-step.active .mark { border-color: var(--accent); }
+
+.scan-step.done .mark { border-color: var(--success); background: var(--success-soft); }
+
+.scan-step .mark .icon { width: 11px; height: 11px; }
+
+.scan-step-body { min-width: 0; }
+.scan-step-body strong { display: block; font-size: 13.5px; }
+.scan-step-body small { font-size: 11.5px; color: var(--text-muted); }
+.scan-step .status { margin-left: auto; font-size: 11.5px; color: var(--text-muted); flex: none; }
+
+.scan-timer { font-size: 12px; color: var(--text-muted); }
+
+.scan-timer b { color: var(--accent); font-family: var(--font-mono); }
diff --git a/src/static/css/page.css b/src/static/css/page.css
new file mode 100644
index 0000000..92a6610
--- /dev/null
+++ b/src/static/css/page.css
@@ -0,0 +1,150 @@
+/* ==========================================================================
+   page.css — the standard signed-in page: sidebar + scrolling content column.
+   Used by settings, profile, statistics and team. The chat screen has its
+   own layout in workspace.css.
+   ========================================================================== */
+
+.layout {
+    display: grid;
+    grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
+    min-height: 100vh;
+}
+
+.layout-main {
+    min-width: 0;
+    display: flex;
+    flex-direction: column;
+}
+
+.page-head {
+    padding: 30px 32px 22px;
+    border-bottom: 1px solid var(--border-soft);
+}
+
+.page-head h1 { margin: 6px 0 6px; }
+
+.page-head .dim { font-size: 14px; }
+
+.page-body {
+    flex: 1;
+    display: flex;
+    flex-direction: column;
+    gap: 18px;
+    max-width: 900px;
+    padding: 24px 32px 64px;
+}
+
+/* Sidebar spacing for pages without a conversation list. */
+.sidebar-spacer { flex: 1; min-height: 12px; }
+
+/* --------------------------------------------------------------------------
+   Stat tiles
+   -------------------------------------------------------------------------- */
+
+.tiles {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
+    gap: 14px;
+}
+
+.tile {
+    padding: 17px 18px;
+    border-radius: var(--r-lg);
+    background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.012));
+    border: 1px solid var(--border-soft);
+}
+
+.tile-label {
+    display: flex;
+    align-items: center;
+    gap: 7px;
+    font-size: 11.5px;
+    font-weight: 600;
+    letter-spacing: 0.05em;
+    text-transform: uppercase;
+    color: var(--text-muted);
+}
+
+.tile-label .icon { width: 14px; height: 14px; }
+
+.tile-value {
+    margin-top: 8px;
+    font-size: 27px;
+    font-weight: 700;
+    letter-spacing: -0.02em;
+    line-height: 1.1;
+}
+
+.tile-foot { margin-top: 4px; font-size: 12px; color: var(--text-muted); }
+
+.tile-accent .tile-value { color: var(--accent); }
+.tile-success .tile-value { color: var(--success); }
+.tile-warn .tile-value { color: var(--warn); }
+.tile-danger .tile-value { color: var(--danger); }
+
+/* --------------------------------------------------------------------------
+   Definition rows
+   -------------------------------------------------------------------------- */
+
+.rows { display: flex; flex-direction: column; }
+
+.row-item {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 16px;
+    padding: 13px 0;
+    border-bottom: 1px solid var(--border-soft);
+}
+
+.row-item:last-child { border-bottom: none; }
+
+.row-item .row-label { font-size: 13.5px; color: var(--text-muted); }
+
+.row-item .row-value { font-size: 14px; font-weight: 500; text-align: right; }
+
+/* --------------------------------------------------------------------------
+   Inline forms
+   -------------------------------------------------------------------------- */
+
+.inline-form {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 10px;
+    align-items: flex-end;
+}
+
+.inline-form .field { flex: 1 1 190px; }
+
+.form-msg { min-height: 1em; font-size: 12.5px; color: var(--danger); }
+
+.form-msg.ok { color: var(--success); }
+
+@media (max-width: 900px) {
+    .layout { grid-template-columns: minmax(0, 1fr); }
+    .sidebar {
+        position: fixed;
+        z-index: 500;
+        top: 0; left: 0; bottom: 0;
+        width: var(--sidebar-w);
+        transform: translateX(-100%);
+        transition: transform var(--med) var(--ease);
+        box-shadow: var(--shadow-lg);
+    }
+    .sidebar.is-open { transform: none; }
+    .page-head { padding: 22px 18px 18px; }
+    .page-body { padding: 18px 18px 60px; }
+}
+
+/* A mobile bar to open the drawer; hidden on desktop. */
+.mobile-bar {
+    display: none;
+    align-items: center;
+    gap: 12px;
+    padding: 12px 16px;
+    border-bottom: 1px solid var(--border-soft);
+}
+
+@media (max-width: 900px) {
+    .mobile-bar { display: flex; }
+}
diff --git a/src/static/css/stats.css b/src/static/css/stats.css
new file mode 100644
index 0000000..0334a05
--- /dev/null
+++ b/src/static/css/stats.css
@@ -0,0 +1,215 @@
+/* ==========================================================================
+   stats.css — the administrator statistics screen.
+   Charts are drawn with plain elements (bars, lines, donuts) so there is no
+   charting library to load and nothing to break offline.
+   ========================================================================== */
+
+.range-bar {
+    display: inline-flex;
+    gap: 2px;
+    padding: 3px;
+    border-radius: var(--r-pill);
+    background: var(--surface);
+    border: 1px solid var(--border-soft);
+}
+
+.range-bar button {
+    padding: 6px 13px;
+    border-radius: var(--r-pill);
+    font-size: 12px;
+    font-weight: 600;
+    color: var(--text-muted);
+    transition: all var(--fast) var(--ease);
+}
+
+.range-bar button:hover { color: var(--text); }
+.range-bar button.is-active { color: #04121F; background: var(--accent); }
+
+/* ---- member cards ---- */
+
+.member-grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
+    gap: 16px;
+}
+
+.member-card {
+    display: flex;
+    flex-direction: column;
+    gap: 14px;
+    padding: 18px;
+    border-radius: var(--r-lg);
+    background: linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.012));
+    border: 1px solid var(--border-soft);
+    animation: rise-in var(--med) var(--ease) both;
+}
+
+.member-head { display: flex; align-items: center; gap: 13px; }
+
+.member-head .avatar { width: 40px; height: 40px; font-size: 15px; }
+
+.member-id { min-width: 0; flex: 1; }
+.member-id strong { display: block; font-size: 15px; }
+.member-id small { font-size: 11.5px; color: var(--text-muted); }
+
+/* Donut: a conic-gradient ring driven by --pct */
+.donut {
+    position: relative;
+    width: 56px;
+    height: 56px;
+    flex: none;
+    border-radius: 50%;
+    background:
+        conic-gradient(var(--donut-color, var(--accent)) calc(var(--pct, 0) * 1%),
+                       var(--surface-3) 0);
+    display: grid;
+    place-items: center;
+    transition: --pct var(--slow) var(--ease);
+}
+
+.donut::after {
+    content: "";
+    position: absolute;
+    inset: 6px;
+    border-radius: 50%;
+    background: var(--surface);
+}
+
+.donut span {
+    position: relative;
+    font-size: 12.5px;
+    font-weight: 700;
+    font-family: var(--font-mono);
+}
+
+/* ---- bars ---- */
+
+.bars { display: flex; flex-direction: column; gap: 9px; }
+
+.bar-row { display: flex; flex-direction: column; gap: 5px; }
+
+.bar-top {
+    display: flex;
+    align-items: baseline;
+    justify-content: space-between;
+    gap: 10px;
+    font-size: 12.5px;
+}
+
+.bar-top .bar-value { font-family: var(--font-mono); color: var(--text-muted); font-size: 11.5px; }
+
+.bar-track {
+    height: 7px;
+    border-radius: var(--r-pill);
+    background: var(--surface-3);
+    overflow: hidden;
+}
+
+.bar-fill {
+    height: 100%;
+    border-radius: var(--r-pill);
+    background: linear-gradient(90deg, var(--accent-deep), var(--accent));
+    transition: width var(--slow) var(--ease);
+}
+
+.bar-fill.warn { background: linear-gradient(90deg, #D99A0B, var(--warn)); }
+.bar-fill.danger { background: linear-gradient(90deg, #C93F3F, var(--danger)); }
+.bar-fill.violet { background: linear-gradient(90deg, #7C5CE0, var(--violet)); }
+.bar-fill.success { background: linear-gradient(90deg, #1F9C6E, var(--success)); }
+
+/* ---- trend chart ---- */
+
+.trend {
+    display: flex;
+    align-items: flex-end;
+    gap: 3px;
+    height: 68px;
+    padding: 8px 0 0;
+}
+
+.trend-col {
+    position: relative;
+    flex: 1;
+    display: flex;
+    flex-direction: column;
+    justify-content: flex-end;
+    height: 100%;
+    min-width: 0;
+}
+
+.trend-bar {
+    width: 100%;
+    border-radius: 3px 3px 0 0;
+    background: linear-gradient(180deg, var(--accent), var(--accent-deep));
+    min-height: 2px;
+    transition: height var(--slow) var(--ease);
+}
+
+.trend-bar.override { background: linear-gradient(180deg, var(--warn), #D99A0B); }
+
+.trend-col:hover .trend-bar { filter: brightness(1.25); }
+
+.trend-axis {
+    display: flex;
+    justify-content: space-between;
+    margin-top: 6px;
+    font-size: 10.5px;
+    color: var(--text-muted);
+}
+
+/* ---- timeline ---- */
+
+.timeline {
+    display: flex;
+    flex-direction: column;
+    max-height: 520px;
+    overflow-y: auto;
+    padding-right: 4px;
+}
+
+.tl-item {
+    display: grid;
+    grid-template-columns: 18px minmax(0, 1fr) auto;
+    gap: 12px;
+    padding: 10px 0;
+    border-bottom: 1px solid var(--border-soft);
+    font-size: 13px;
+}
+
+.tl-item:last-child { border-bottom: none; }
+
+.tl-mark {
+    display: grid;
+    place-items: center;
+    width: 18px;
+    height: 18px;
+    margin-top: 2px;
+    border-radius: 50%;
+    background: var(--surface-2);
+    border: 1px solid var(--border);
+}
+
+.tl-mark .icon { width: 10px; height: 10px; }
+.tl-item.kind-blocked .tl-mark { color: var(--danger); border-color: rgba(248,113,113,0.4); }
+.tl-item.kind-override .tl-mark { color: var(--warn); border-color: rgba(251,191,36,0.4); }
+.tl-item.kind-prompt .tl-mark { color: var(--accent); border-color: var(--accent-line); }
+.tl-item.kind-login .tl-mark { color: var(--success); border-color: rgba(52,211,153,0.4); }
+
+.tl-body { min-width: 0; }
+.tl-body strong { font-weight: 600; }
+.tl-body small { display: block; color: var(--text-muted); font-size: 12px; overflow-wrap: anywhere; }
+.tl-time { font-size: 11.5px; color: var(--text-muted); white-space: nowrap; font-family: var(--font-mono); }
+
+/* ---- legend ---- */
+
+.legend {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 14px;
+    font-size: 11.5px;
+    color: var(--text-muted);
+}
+
+.legend span { display: inline-flex; align-items: center; gap: 6px; }
+
+.swatch { width: 9px; height: 9px; border-radius: 2px; }
