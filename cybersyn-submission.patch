-@app.post(ROUTES["CHAT"])
-def employee_chat():
-    data = get_json_dict()
-    if data is None:
-        return chat_response(True, message="Request body must be a JSON object.",
-                             status=400)
-    try:
-        parent_id = to_int(data.get("Parent_id"))
-        employee_id = to_int(data.get("Employee_id"))
-        if parent_id is None:
-            raise ChatError("'Parent_id' must be a positive integer.", 400)
-        if employee_id is None:
-            raise ChatError("'Employee_id' must be a positive integer.", 400)
-
-        # Only the signed-in member may send prompts on their own behalf.
-        # Checked before the member lookup so an outsider cannot use this route
-        # to enumerate which member IDs exist.
-        if require_member(DB_FILE, data)[0] is None:
-            raise ChatError("Your session has ended. Sign in again to continue.", 401)
-
-        # The browser collects an administrator's approval for an override; the
-        # server is what enforces it, against that administrator's own session
-        # token. Authorised here, before any work is done, so an unapproved
-        # override is refused rather than quietly failing later.
-        if data.get("bypass") is True:
-            admin = admin_from_token(DB_FILE, data.get("admin_token"))
-            if admin is None or int(admin["id"]) != parent_id:
-                raise ChatError(
-                    "Overriding a block needs a valid administrator session. "
-                    "Ask an administrator to approve this message.", 401)
-
-        emp = employee_row(parent_id, employee_id)
-        if emp is None:
-            raise ChatError(not_found_employee_message(parent_id, employee_id), 404)
-
-        prompt = data.get("prompt")
-        if not non_empty_str(prompt):
-            raise ChatError("'prompt' must be a non-empty string.", 400)
-        bypass = data.get("bypass", False)
-        if not isinstance(bypass, bool):
-            raise ChatError("'bypass' must be true or false.", 400)
-        chat_id = to_int(data.get("chat_id"))
-        if data.get("chat_id") is not None and (chat_id is None or get_chat(DB_FILE, parent_id, employee_id, chat_id) is None):
-            raise ChatError("That chat was not found for this team member.", 404)
-
-        # Request values win, saved settings are the fallback.
-        saved = get_settings(parent_id, employee_id)
-        flags = {}
-        for key in ("check1", "check2", "check3"):
-            if key in data:
-                if not isinstance(data[key], bool):
-                    raise ChatError(f"'{key}' must be true or false.", 400)
-                flags[key] = data[key]
-            else:
-                flags[key] = bool(saved[key])
-
-        api_key = decrypt_secret(saved["API_KEY"]).strip()
-        model = data.get("MODEL_NAME")
-        if not non_empty_str(model):
-            model = saved["MODEL_NAME"] or DEFAULT_MODEL
-        model = model.strip()
-
-        if not api_key:
-            raise ChatError("No API_KEY provided.", 400)
-
-        # Privacy checks (fail closed: any scanner error stops the request).
-        if bypass:
-            record_block(DB_FILE, parent_id, employee_id, "override",
-                         "administrator approved")
-        else:
-            for stage, _ in CHECKS:
-                if not flags[stage]:
-                    continue
-                result = run_check(stage, prompt)
-                if result.get("blocked"):
-                    info = build_block_info(stage, result)
-                    record_block(DB_FILE, parent_id, employee_id, stage, info["main_cause"])
-                    msg = (f"Blocked by {stage} ({info['main_cause']}): "
-                           f"'{info['snippet']}' on line {info['line']}")
-                    return chat_response(False, True, reply=NULL, message=msg, block_info=info)
-
-        answer = call_openai(api_key, model, prompt)
-
-        # Save to the chat history (one row per chat in CHATS).
-        chat_id = save_exchange(DB_FILE, parent_id, employee_id, chat_id, prompt, answer)
-        bump_answered(DB_FILE, parent_id, employee_id)
-
-        return jsonify({"error": False, "blocked": False, "reply_message": answer, "error_message": NULL, "block_info": NULL, "chat_id": chat_id})
-
-    except ChatError as exc:
-        return chat_response(True, message=exc.message, status=exc.status)
