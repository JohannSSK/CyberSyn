# CyberSyn environment example.
# Copy to .env and adjust. Docker Compose reads .env automatically.
# Every value is optional; the defaults suit the Docker flow.

# --- Bind ---
# CYBERSYN_HOST=0.0.0.0
# CYBERSYN_PORT=5000

# --- Encryption ---
# Fernet key used to encrypt stored provider API keys.
# Leave unset to generate src/backend/secret.key (native) or a key in the
# secrets volume (Docker). Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CYBERSYN_KEY=
# CYBERSYN_KEY_FILE=

# --- Administrator signup ---
# Set to 1 to allow anyone to create an administrator account.
# CYBERSYN_ALLOW_OPEN_SIGNUP=0

# --- Screening ---
# CYBERSYN_SCREEN_BUDGET=45
# CYBERSYN_MAX_SCREEN_BUDGET=180
# CYBERSYN_AI_TIMEOUT=60
# CYBERSYN_SCANNER_FALLBACK=0
# CYBERSYN_WARM_MODELS=1

# --- Requests and limits ---
# CYBERSYN_MAX_BODY_BYTES=262144
# CYBERSYN_MAX_PROMPT_CHARS=16000
# CYBERSYN_RATE_LIMIT=1
# CYBERSYN_TRUST_PROXY=0

# --- Cookies / TLS ---
# CYBERSYN_COOKIE_SECURE=0

# --- Logging ---
# CYBERSYN_LOG_PROMPT_PREVIEW=0

# --- Model cache (native) ---
# CYBERSYN_MODEL_CACHE=src/backend/model-cache

# --- LiteLLM ---
# CYBERSYN_LITELLM_NETWORK=0

# --- Server ---
# CYBERSYN_DEBUG=0
# CYBERSYN_THREADS=8
# CYBERSYN_ALLOW_PRIVATE_BASE=1
# CYBERSYN_DB_FILE=
