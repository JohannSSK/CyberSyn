/* ==========================================================================
   Cybersyn — Warm Human-Centered Design (Editorial Stone & Ink)
   ========================================================================== */

:root {
    --bg-base: #F6F5F0;
    --bg-surface: #FFFFFF;
    --bg-surface-subtle: #EFECE6;
    --bg-surface-hover: #E7E3DA;

    --border-subtle: #E4E1D8;
    --border-strong: #CFCBC0;

    --text-primary: #191918;
    --text-secondary: #575653;
    --text-muted: #87857E;

    --color-primary: #1F5EFF;
    --color-primary-hover: #1749CC;
    --color-accent: #0F766E;
    --color-accent-hover: #115E59;
    --color-success: #15803D;
    --color-danger: #C2410C;
    --color-danger-bg: #FFF7ED;
    --color-danger-border: #FDBA74;
    --color-warning: #B45309;

    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-serif: 'Instrument Serif', Georgia, serif;
    --font-mono: 'JetBrains Mono', monospace;

    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 18px;
    --shadow-sm: 0 1px 3px rgba(25, 25, 24, 0.05);
    --shadow-base: 0 8px 24px -4px rgba(25, 25, 24, 0.06), 0 2px 6px -1px rgba(25, 25, 24, 0.04);
    --shadow-elevated: 0 20px 40px -12px rgba(25, 25, 24, 0.16);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
    background-color: var(--bg-base);
    color: var(--text-primary);
    font-family: var(--font-sans);
    line-height: 1.55;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
}

.hidden { display: none !important; }

/* LIVE LOADING & SCRIPT SCANNING OVERLAY */
.loading-overlay {
    position: fixed;
    inset: 0;
    background: rgba(246, 245, 240, 0.82);
    backdrop-filter: blur(8px);
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.loading-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-elevated);
    padding: 32px;
    width: 100%;
    max-width: 480px;
    text-align: center;
    animation: fadeUp 0.2s ease-out;
}

@keyframes fadeUp {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
}

.loading-spinner-wrap {
    position: relative;
    width: 60px;
    height: 60px;
    margin: 0 auto 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
}

.loading-ring {
    position: absolute;
    inset: 0;
    border: 2.5px solid var(--bg-surface-subtle);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
}

.loading-shield-icon { width: 26px; height: 26px; }

@keyframes spin { to { transform: rotate(360deg); } }

.loading-card h3 { font-size: 1.2rem; font-weight: 600; margin-bottom: 6px; }
.loading-subtitle { font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 22px; }

.loading-steps {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-align: left;
    margin-bottom: 20px;
}

.loading-step {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    border-radius: var(--radius-sm);
    background: var(--bg-base);
    border: 1px solid var(--border-subtle);
    transition: all 0.2s ease;
}

.loading-step.active { background: #F0F5FF; border-color: #BFDBFE; }
.loading-step.done { background: #F0FDF4; border-color: #BBF7D0; }
.loading-step.skipped { opacity: 0.45; }

.step-indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-strong);
    flex-shrink: 0;
}

.loading-step.active .step-indicator {
    background: var(--color-primary);
    box-shadow: 0 0 0 4px rgba(31, 94, 255, 0.18);
}

.loading-step.done .step-indicator { background: var(--color-success); }

.step-text { flex: 1; display: flex; flex-direction: column; }
.step-text strong { font-size: 0.84rem; font-weight: 600; }
.step-text small { font-size: 0.74rem; color: var(--text-secondary); }

.step-status { font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted); font-weight: 500; }
.loading-step.active .step-status { color: var(--color-primary); font-weight: 600; }
.loading-step.done .step-status { color: var(--color-success); font-weight: 600; }
.loading-timer { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-muted); }

/* TOASTS */
.toast-container {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 3000;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.toast {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    padding: 12px 16px;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-elevated);
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 280px;
    max-width: 400px;
    font-size: 0.88rem;
    animation: fadeUp 0.2s ease-out;
}

.toast.success { border-left: 4px solid var(--color-success); }
.toast.error   { border-left: 4px solid var(--color-danger); }
.toast.warning { border-left: 4px solid var(--color-warning); }
.toast.info    { border-left: 4px solid var(--color-primary); }

/* BUTTONS & INPUTS */
button, input, textarea { font-family: inherit; font-size: 0.92rem; }

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 18px;
    font-weight: 500;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.15s ease;
}

.btn:disabled { opacity: 0.5; cursor: not-allowed; }
.btn-primary { background: var(--text-primary); color: #fff; }
.btn-primary:hover:not(:disabled) { background: #333330; }
.btn-accent { background: var(--color-accent); color: #fff; }
.btn-accent:hover:not(:disabled) { background: var(--color-accent-hover); }
.btn-secondary { background: var(--bg-surface); border-color: var(--border-strong); color: var(--text-primary); }
.btn-secondary:hover:not(:disabled) { background: var(--bg-surface-subtle); }
.btn-warning { background: var(--color-warning); color: #fff; }
.btn-warning:hover:not(:disabled) { background: #92400E; }

.btn-danger-outline, .btn-outline-danger {
    background: transparent;
    border-color: var(--border-strong);
    color: var(--color-danger);
}
.btn-danger-outline:hover:not(:disabled), .btn-outline-danger:hover:not(:disabled) {
    background: var(--color-danger-bg);
    border-color: var(--color-danger-border);
}

.btn-text-danger { background: transparent; border: none; color: var(--color-danger); cursor: pointer; font-weight: 500; font-size: 0.84rem; }
.btn-text-danger:hover { text-decoration: underline; }
.btn-sm { padding: 8px 12px; font-size: 0.84rem; }
.btn-link { background: transparent; border: none; color: var(--text-secondary); font-size: 0.85rem; cursor: pointer; }
.btn-link:hover { color: var(--text-primary); }

.input-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
.input-group label { font-size: 0.84rem; font-weight: 500; color: var(--text-secondary); }

.input-group input, .input-group-compact input, .input-box-container textarea {
    background: var(--bg-base);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    padding: 11px 14px;
    border-radius: var(--radius-sm);
    outline: none;
    transition: border-color 0.15s ease, background 0.15s ease;
}

.input-group input:focus, .input-group-compact input:focus, .input-box-container textarea:focus {
    background: var(--bg-surface);
    border-color: var(--text-primary);
}

.input-group-compact { display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px; }
.input-group-compact label { font-size: 0.78rem; font-weight: 500; color: var(--text-secondary); }
.button-group-stacked { display: flex; flex-direction: column; gap: 10px; margin-top: 18px; }
.button-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

/* VIEW 1: PORTAL */
.portal-view { max-width: 980px; margin: 0 auto; padding: 56px 24px; }
.portal-header { text-align: center; margin-bottom: 44px; }
.brand-mark { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 0.95rem; color: var(--text-primary); margin-bottom: 14px; }
.portal-header h1 { font-family: var(--font-serif); font-weight: 400; font-size: 3rem; line-height: 1.1; margin-bottom: 12px; }
.subtitle { color: var(--text-secondary); max-width: 560px; margin: 0 auto; font-size: 0.98rem; }
.portal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }

.card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 32px;
    box-shadow: var(--shadow-base);
    position: relative;
    overflow: hidden;
}

.card-step-pill {
    display: inline-block;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--bg-base);
    padding: 4px 10px;
    border-radius: 99px;
    margin-bottom: 14px;
}

.card-header { margin-bottom: 22px; }
.card-header h2 { font-size: 1.35rem; font-weight: 600; }
.section-desc { color: var(--text-secondary); font-size: 0.88rem; margin-top: 4px; }

.session-badge {
    background: #F0FDF4;
    border: 1px solid #BBF7D0;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.session-info { display: flex; align-items: center; gap: 10px; }
.session-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-success); }
.session-info strong { display: block; font-size: 0.84rem; color: var(--color-success); }
.session-info span { font-size: 0.78rem; color: var(--text-secondary); }

.auth-card.locked .card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(4px);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    text-align: center;
}

.lock-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bg-base);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px;
    color: var(--text-secondary);
}

.lock-message h3 { font-size: 1.05rem; font-weight: 600; margin-bottom: 6px; }
.lock-message p { font-size: 0.86rem; color: var(--text-secondary); }

/* VIEW 2: WORKSPACE */
.workspace-view { display: grid; grid-template-columns: 300px 1fr; height: 100vh; overflow: hidden; }

.workspace-sidebar {
    background: var(--bg-surface);
    border-right: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    padding: 22px 18px;
    gap: 22px;
    overflow-y: auto;
}

.user-profile-badge {
    background: var(--bg-base);
    border: 1px solid var(--border-subtle);
    padding: 10px 12px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    gap: 10px;
}

.avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--text-primary);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 0.88rem;
}

.profile-details { display: flex; flex-direction: column; overflow: hidden; }
.profile-name { font-weight: 600; font-size: 0.88rem; }
.profile-sub { font-size: 0.75rem; color: var(--text-muted); }
.sidebar-section { display: flex; flex-direction: column; gap: 12px; }
.section-header-row { display: flex; align-items: center; justify-content: space-between; }
.section-title { font-size: 0.76rem; font-weight: 600; color: var(--text-secondary); }

.sync-indicator {
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 99px;
    background: #F0FDF4;
    color: var(--color-success);
    border: 1px solid #BBF7D0;
}

.sync-indicator.unsaved { background: #FEF3C7; color: var(--color-warning); border-color: #FDE68A; }
.toggle-list { display: flex; flex-direction: column; gap: 12px; }
.toggle-item { display: flex; align-items: flex-start; gap: 10px; cursor: pointer; user-select: none; }
.toggle-item input { display: none; }

.toggle-switch {
    width: 36px;
    height: 20px;
    margin-top: 2px;
    background: var(--border-strong);
    border-radius: 20px;
    position: relative;
    transition: background 0.2s ease;
    flex-shrink: 0;
}

.toggle-switch::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #fff;
    top: 3px;
    left: 3px;
    transition: transform 0.2s ease;
}

.toggle-item input:checked + .toggle-switch { background: var(--color-accent); }
.toggle-item input:checked + .toggle-switch::after { transform: translateX(16px); }
.toggle-text { display: flex; flex-direction: column; }
.toggle-text strong { font-size: 0.84rem; font-weight: 500; }
.toggle-text small { font-size: 0.74rem; color: var(--text-muted); }
.sidebar-footer { margin-top: auto; padding-top: 14px; border-top: 1px solid var(--border-subtle); }

/* MAIN CHAT */
.workspace-main { display: flex; flex-direction: column; height: 100vh; background: var(--bg-base); }

.workspace-topbar {
    height: 54px;
    border-bottom: 1px solid var(--border-subtle);
    padding: 0 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-surface);
}

.topbar-status { display: flex; align-items: center; gap: 8px; font-size: 0.86rem; color: var(--text-secondary); }
.status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-success); }
.status-dot.warning { background: var(--color-warning); }

.unprotected-banner {
    background: #FFFBEB;
    border-bottom: 1px solid #FDE68A;
    color: #92400E;
    padding: 10px 28px;
    font-size: 0.84rem;
    text-align: center;
}

.chat-viewport {
    flex: 1;
    overflow-y: auto;
    padding: 32px 28px;
    max-width: 840px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.empty-state { margin: auto 0; text-align: center; padding: 32px 16px; }
.empty-state h2 { font-family: var(--font-serif); font-weight: 400; font-size: 2.2rem; margin-bottom: 8px; }
.empty-state p { color: var(--text-secondary); font-size: 0.92rem; max-width: 460px; margin: 0 auto 24px; }

.starter-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    max-width: 620px;
    margin: 0 auto;
    text-align: left;
}

.starter-chip {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    cursor: pointer;
    transition: all 0.15s ease;
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.starter-chip:hover { border-color: var(--text-primary); box-shadow: var(--shadow-sm); }
.starter-chip strong { font-size: 0.82rem; font-weight: 600; color: var(--text-primary); }
.starter-chip span { font-size: 0.76rem; color: var(--text-secondary); }

.message-bubble {
    max-width: 85%;
    padding: 14px 18px;
    border-radius: var(--radius-md);
    line-height: 1.6;
    font-size: 0.93rem;
    word-wrap: break-word;
    white-space: pre-wrap;
}

.message-bubble.user-bubble { align-self: flex-end; background: var(--text-primary); color: #fff; border-bottom-right-radius: 3px; }
.message-bubble.ai-bubble { align-self: flex-start; background: var(--bg-surface); border: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm); border-bottom-left-radius: 3px; }
.message-bubble.ai-bubble.bypassed { border-left: 3px solid var(--color-warning); }
.message-bubble.system-bubble { align-self: center; background: var(--bg-surface-subtle); color: var(--text-secondary); font-size: 0.84rem; padding: 10px 16px; border-radius: 99px; }
.message-bubble.intercept-bubble { align-self: flex-start; background: var(--color-danger-bg); border: 1px solid var(--color-danger-border); color: var(--text-primary); white-space: normal; }

.bubble-header { font-size: 0.72rem; font-weight: 600; margin-bottom: 4px; color: var(--text-muted); }
.user-bubble .bubble-header { color: rgba(255, 255, 255, 0.7); }

.chat-input-wrapper { padding: 16px 28px 22px; background: var(--bg-base); }

.input-box-container {
    max-width: 800px;
    margin: 0 auto;
    background: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: 8px;
    display: flex;
    gap: 10px;
    box-shadow: var(--shadow-sm);
}

.input-box-container textarea { flex: 1; border: none; background: transparent; resize: none; min-height: 44px; max-height: 150px; padding: 8px 10px; }
.input-box-container textarea:focus { border: none; }
.btn-send { align-self: flex-end; height: 40px; padding: 0 20px; }
.input-footnote { font-size: 0.74rem; color: var(--text-muted); margin-top: 8px; text-align: center; }

/* VIEW 3: MODAL */
.modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(25, 25, 24, 0.45);
    backdrop-filter: blur(4px);
    z-index: 2500;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.modal-dialog {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 600px;
    box-shadow: var(--shadow-elevated);
    overflow: hidden;
    animation: fadeUp 0.2s ease-out;
}

.modal-header { padding: 22px 24px; border-bottom: 1px solid var(--border-subtle); display: flex; align-items: flex-start; justify-content: space-between; }
.modal-title-wrap { display: flex; flex-direction: column; gap: 6px; }
.alert-badge { display: inline-block; align-self: flex-start; font-size: 0.72rem; font-weight: 600; padding: 3px 10px; border-radius: 99px; background: var(--color-danger-bg); color: var(--color-danger); border: 1px solid var(--color-danger-border); }
.modal-header h2 { font-size: 1.25rem; font-weight: 600; }
.alert-subtitle { font-size: 0.86rem; color: var(--text-secondary); }
.btn-close { background: transparent; border: none; font-size: 1.5rem; color: var(--text-muted); cursor: pointer; }
.modal-body { padding: 22px 24px; display: flex; flex-direction: column; gap: 18px; max-height: 70vh; overflow-y: auto; }

.alert-summary-box {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    background: var(--bg-base);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 14px;
}

.summary-item { display: flex; flex-direction: column; }
.summary-label { font-size: 0.72rem; color: var(--text-muted); font-weight: 500; }
.summary-value { font-size: 0.88rem; font-weight: 600; margin-top: 2px; }
.warning-text { color: var(--color-danger); }
.matches-section h4 { font-size: 0.82rem; color: var(--text-secondary); font-weight: 600; margin-bottom: 8px; }
.matches-list { display: flex; flex-direction: column; gap: 8px; }
.match-item { background: var(--bg-base); border: 1px solid var(--border-subtle); padding: 12px; border-radius: var(--radius-sm); font-size: 0.84rem; }
.match-header { display: flex; justify-content: space-between; margin-bottom: 6px; font-weight: 600; color: var(--text-secondary); font-size: 0.78rem; }
.match-snippet { font-family: var(--font-mono); background: var(--color-danger-bg); color: var(--color-danger); border: 1px solid var(--color-danger-border); padding: 4px 8px; border-radius: 4px; display: inline-block; word-break: break-all; }
.bypass-accordion { border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); overflow: hidden; }
.bypass-header { background: var(--bg-base); padding: 12px 16px; cursor: pointer; display: flex; align-items: center; justify-content: space-between; font-weight: 500; font-size: 0.86rem; color: var(--text-secondary); }
.bypass-content { padding: 16px; background: var(--bg-surface); border-top: 1px solid var(--border-subtle); }
.bypass-disclaimer { font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 12px; }
.modal-footer { padding: 14px 24px; background: var(--bg-base); border-top: 1px solid var(--border-subtle); display: flex; justify-content: flex-end; }

@media (max-width: 900px) {
    .portal-grid, .workspace-view, .starter-grid { grid-template-columns: 1fr; }
    .workspace-sidebar { display: none; }
}

/* AUTH-LOGIN-START */
#portal-view.auth-shell {
    --auth-ink: #1c1917;
    --auth-ink-soft: #a8a29e;
    --auth-stone: #fafaf9;
    --auth-panel: #f5f5f4;
    --auth-line: #e7e5e4;
    --auth-text: #292524;
    --auth-muted: #78716c;
    --auth-danger: #b42318;
    display: grid;
    grid-template-columns: minmax(340px, 5fr) 7fr;
    gap: 0;
    align-items: stretch;
    width: 100%;
    max-width: none;
    min-height: 100vh;
    margin: 0;
    padding: 0;
    background: var(--auth-stone);
    color: var(--auth-text);
}

#portal-view.auth-shell.hidden,
.auth-shell .hidden {
    display: none !important;
}

.auth-brand {
    background: var(--auth-ink);
    color: #fafaf9;
    padding: 48px 56px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
}

.auth-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.02em;
}

.auth-brand-body h2 {
    margin: 0 0 16px;
    font-size: 30px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #fafaf9;
}

.auth-brand-body > p {
    margin: 0 0 32px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--auth-ink-soft);
    max-width: 440px;
}

.auth-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 440px;
}

.auth-points li {
    padding-left: 16px;
    border-left: 2px solid #57534e;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.auth-points strong {
    font-size: 14px;
    font-weight: 600;
    color: #fafaf9;
}

.auth-points span {
    font-size: 13px;
    line-height: 1.55;
    color: var(--auth-ink-soft);
}

.auth-brand-foot {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: #78716c;
}

.auth-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 48px 32px;
    background: var(--auth-stone);
}

.auth-step {
    width: 100%;
    max-width: 400px;
    animation: authFadeIn 0.3s ease;
}

@keyframes authFadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
}

.auth-progress {
    display: flex;
    gap: 6px;
    margin-bottom: 28px;
}

.auth-progress span {
    flex: 1;
    height: 3px;
    border-radius: 2px;
    background: var(--auth-line);
}

.auth-progress span.is-active {
    background: var(--auth-ink);
}

.auth-eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--auth-muted);
    margin-bottom: 10px;
}

.auth-title {
    margin: 0 0 10px;
    font-size: 28px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--auth-ink);
}

.auth-lead {
    margin: 0 0 28px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--auth-muted);
}

.auth-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 18px;
}

.auth-field label {
    font-size: 13px;
    font-weight: 600;
    color: var(--auth-text);
}

.auth-field input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px;
    font-size: 15px;
    font-family: inherit;
    color: var(--auth-ink);
    background: #ffffff;
    border: 1px solid #d6d3d1;
    border-radius: 8px;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.auth-field input::placeholder {
    color: #a8a29e;
}

.auth-field input:focus {
    border-color: var(--auth-ink);
    box-shadow: 0 0 0 3px rgba(28, 25, 23, 0.1);
}

.auth-btn-primary {
    width: 100%;
    margin-top: 6px;
    padding: 13px 16px;
    font-size: 15px;
    font-weight: 600;
    font-family: inherit;
    color: #fafaf9;
    background: var(--auth-ink);
    border: 1px solid var(--auth-ink);
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.05s ease;
}

.auth-btn-primary:hover {
    background: #44403c;
}

.auth-btn-primary:active {
    transform: translateY(1px);
}

.auth-btn-primary:focus-visible {
    outline: 2px solid var(--auth-ink);
    outline-offset: 2px;
}

.auth-secondary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px solid var(--auth-line);
}

.auth-link {
    padding: 0;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    color: var(--auth-muted);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.15s ease;
}

.auth-link:hover {
    color: var(--auth-ink);
    text-decoration: underline;
}

.auth-link-danger:hover {
    color: var(--auth-danger);
}

.auth-context {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px 16px;
    margin-bottom: 22px;
    background: var(--auth-panel);
    border: 1px solid var(--auth-line);
    border-radius: 8px;
}

.auth-context-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.auth-context-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--auth-muted);
}

.auth-context-text strong {
    font-size: 14px;
    color: var(--auth-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.auth-footnote {
    width: 100%;
    max-width: 400px;
    margin-top: 40px;
    font-size: 12px;
    line-height: 1.6;
    color: #a8a29e;
    text-align: center;
}

@media (max-width: 860px) {
    #portal-view.auth-shell {
        grid-template-columns: 1fr;
        min-height: 100vh;
    }
    .auth-brand {
        padding: 28px 24px;
        gap: 16px;
    }
    .auth-brand-body h2 {
        font-size: 22px;
        margin-bottom: 0;
    }
    .auth-brand-body > p,
    .auth-points,
    .auth-brand-foot {
        display: none;
    }
    .auth-panel {
        padding: 36px 24px;
        justify-content: flex-start;
    }
}
/* AUTH-LOGIN-END */
